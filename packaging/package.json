    { "source": "include/shaders/generated/shader_abi.glsl", "destination": "include/shaders/generated/shader_abi.glsl" }
  ],
  "licenses": [
    { "source": "LICENSE", "destination": "licenses/gpu/LICENSE" },
    { "source": "lib/vk.c3l/LICENSE", "destination": "licenses/vk/LICENSE" },
    { "source": "lib/vma.c3l/LICENSE", "destination": "licenses/vma/LICENSE" },
    { "source": "lib/spvreflect.c3l/LICENSE", "destination": "licenses/spvreflect/LICENSE" },
    { "source": "lib/spvreflect.c3l/LICENSE.spirv-reflect.apache-2.0", "destination": "licenses/spvreflect/LICENSE.spirv-reflect.apache-2.0" },
    { "source": "lib/spvreflect.c3l/NOTICE", "destination": "licenses/spvreflect/NOTICE" }
  ],
  "targets": {
    "linux-x64": {
      "linked-libraries": [ ":libvulkan.so.1", "VulkanMemoryAllocator", "spvreflect", "stdc++" ],
      "native": [
        { "source": "lib/vma.c3l/linked-libs/linux-x64/libVulkanMemoryAllocator.a", "destination": "linked-libs/linux-x64/libVulkanMemoryAllocator.a" },
        { "source": "lib/spvreflect.c3l/linux/libspvreflect.a", "destination": "linked-libs/linux-x64/libspvreflect.a" }
      ],
      "runtime": {
        "package-owned-runtime-files": [],
        "system-prerequisites": [
          { "name": "Vulkan loader", "discovery": "libvulkan.so.1" },
          { "name": "C++ runtime", "discovery": "libstdc++.so.6" }
        ]
      }
    },
    "windows-x64": {
      "linked-libraries": [ "vulkan-1", "VulkanMemoryAllocator", "spvreflect" ],
      "native": [
        { "source": "lib/vk.c3l/windows/vulkan-1.lib", "destination": "linked-libs/windows-x64/vulkan-1.lib" },
        { "source": "lib/spvreflect.c3l/windows/spvreflect.lib", "destination": "linked-libs/windows-x64/spvreflect.lib" }
      ],
      "generated-native": {
        "source": "lib/vma.c3l/linked-libs/windows-x64/VulkanMemoryAllocator.lib",
        "destination": "linked-libs/windows-x64/VulkanMemoryAllocator.lib"
      },
      "runtime": {
        "package-owned-runtime-files": [],
        "system-prerequisites": [
          { "name": "Vulkan loader", "discovery": "vulkan-1.dll" },
          { "name": "Microsoft Visual C++ dynamic release runtime", "discovery": "declarative-only" }
        ]
      }
    }
  },
  "windows-vma-build": {
    "upstream-commit": "1d8f600fd424278486eade7ed3e877c99f0846b1",
    "upstream-header-sha256": "90ce12fc4a2466235a09ae02905dd0c13aee80c1bbf11b331ab61230c2ceb112",
    "vulkan-sdk-version": "1.3.290.0",
    "wrapper-source": "lib/vma.c3l/scripts/vma_impl.cpp",
    "size-probe-source": "lib/vma.c3l/scripts/vma_size_probe.cpp",
    "build-script": "lib/vma.c3l/scripts/build-vma-windows.sh",
    "required-directive": "DEFAULTLIB:MSVCRT",
    "forbidden-directives": [ "DEFAULTLIB:LIBCMT", "DEFAULTLIB:LIBCMTD", "DEFAULTLIB:MSVCRTD" ]
  }
}
