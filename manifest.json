{
  // C3 library providing module `gpu`. Backend bindings (vk, vma) are vendored
  // under lib/ as git submodules; consumers resolve them via their own
  // dependency-search-paths (see test/project.json).
  "provides": "gpu",
  // Native libs for this library's own targets live here.
  "linklib-dir": "linked-libs",
  // Strict root plus the explicit compatibility profile and its backend.
  "sources": [
    "gpu/gpu.c3", "gpu/gpu.c3i", "gpu/types.c3",
    "gpu/compat/compat.c3", "gpu/compat/compat.c3i", "gpu/compat/types.c3",
    "gpu/compat/faults.c3", "gpu/compat/device.c3", "gpu/compat/caps.c3",
    "gpu/compat/memory.c3", "gpu/compat/buffer.c3", "gpu/compat/texture.c3",
    "gpu/compat/descriptor_heap.c3", "gpu/compat/pipeline.c3", "gpu/compat/command.c3",
    "gpu/compat/sync.c3", "gpu/compat/queue.c3", "gpu/compat/swapchain.c3",
    "gpu/compat/debug.c3", "gpu/compat/shader_abi.c3", "gpu/compat/vk/**"
  ],
  "targets": {
    "linux-x64": {
      "link-args": [],
      // Backend bindings this target depends on.
      "dependencies": [ "vk", "vma", "spvreflect" ],
      "linked-libraries": []
    },
    "windows-x64": {
      // Build the VMA static library during Windows setup; its dependency
      // manifest supplies the native link input.
      "link-args": [],
      "dependencies": [ "vk", "vma", "spvreflect" ],
      "linked-libraries": []
    }
  }
}
