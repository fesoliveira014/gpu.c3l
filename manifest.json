{
  // C3 library providing module `gpu`. Backend bindings (vk, vma) are vendored
  // under lib/ as git submodules; consumers resolve them via their own
  // dependency-search-paths (see test/project.json).
  "provides": "gpu",
  // Native libs for this library's own targets live here.
  "linklib-dir": "linked-libs",
  // Public facade, platform surfaces, shared internals, and the Vulkan backend.
  "sources": [
    "gpu/gpu.c3", "gpu/gpu.c3i", "gpu/internal/**",
    "gpu/surface/**", "gpu/vk/**"
  ],
  "targets": {
    "linux-x64": {
      "link-args": [],
      // Backend bindings this target depends on.
      "dependencies": [ "vk", "vma", "spvreflect" ],
      "linked-libraries": []
    },
    "windows-x64": {
      // Build the VMA static library during Windows setup; its dependency
      // manifest supplies the native link input.
      "link-args": [],
      "dependencies": [ "vk", "vma", "spvreflect" ],
      "linked-libraries": []
    }
  }
}
