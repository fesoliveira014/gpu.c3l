{
  // C3 library providing module `gpu`. Backend bindings (vk, vma) are vendored
  // under lib/ as git submodules; consumers resolve them via their own
  // dependency-search-paths (see test/project.json).
  "provides": "gpu",
  // Native libs for this library's own targets live here.
  "linklib-dir": "linked-libs",
  // Root module files plus the gpu::vk backend subdir. Without listing vk/**,
  // the backend module is not compiled into the library.
  "sources": [
    "gpu.c3", "gpu.c3i", "types.c3", "faults.c3", "device.c3",
    "caps.c3", "memory.c3", "buffer.c3", "texture.c3",
    "pipeline.c3", "command.c3", "sync.c3", "queue.c3", "slot_table.c3",
    "vk/**"
  ],
  "targets": {
    "linux-x64": {
      "link-args": [],
      // Backend bindings this target depends on.
      "dependencies": [ "vk", "vma" ],
      "linked-libraries": []
    },
    "windows-x64": {
      // Declare-only: builds/links here are not yet proven because vma.c3l
      // does not ship a Windows VulkanMemoryAllocator static library.
      "link-args": [],
      "dependencies": [ "vk", "vma" ],
      "linked-libraries": []
    }
  }
}
