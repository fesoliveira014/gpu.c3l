{
  "langrev": "1",
  // Whitebox harness: compiles the library sources directly (list mirrors
  // manifest.json — c3c has no single-star glob) so no gpu.c3l resolution or
  // symlinks are needed. Bindings resolve from ../lib by real directory name.
  // Consumer-style resolution is exercised by examples/getting_started and
  // the gpu.c3l-samples repository.
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "../lib" ],
  "dependencies": [ "vk", "vma", "spvreflect" ],
  // The vendored VulkanMemoryAllocator.lib is built /MD (release CRT); linking
  // c3c's dynamic-debug default against it mixes debug/release STL DLLs, which
  // crashes in VMA's std::mutex when the runtimes drift apart.
  "wincrt": "dynamic",
  "sources": [
    "../gpu/gpu.c3i", "../gpu/gpu.c3", "../gpu/surface/**",
    "../gpu/internal/**",
    "src/test_lifetime_helpers.c3", "src/bench_lifetime.c3"
  ],
  "output": "build",
  "targets": {
    "smoke": {
      "type": "executable",
      "sources": [ "src/smoke.c3" ]
    },
    // Advisory pipeline-cache lookup timing; executable so it never gates CI.
    // Needs an ICD — pin lavapipe via VK_DRIVER_FILES when running this target.
    "pipeline_cache_bench": {
      "type": "executable",
      "sources": [ "src/pipeline_cache_bench.c3" ]
    },
    // Advisory direct Vulkan/public command-path and submitted lifecycle
    // calibration. Needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "command_path_baseline_bench": {
      "type": "executable",
      "sources": [
        "src/command_path_baseline_bench.c3",
        "src/command_path_baseline_native.c3"
      ]
    },
    // Advisory submission, completed-point polling, and immediate destruction
    // timing; executable so it never gates CI. Needs an ICD.
    "lifecycle_bench": {
      "type": "executable",
      "sources": [ "src/lifecycle_bench.c3" ]
    },
    // Advisory resource operation timing across worker counts 1/2/4;
    // executable so it never gates CI. Needs an ICD — pin lavapipe via
    // VK_DRIVER_FILES.
    "resource_create_bench": {
      "type": "executable",
      "sources": [ "src/resource_create_bench.c3" ]
    },
    // Advisory explicit caller-owned upload throughput across worker and
    // payload combinations; executable so timing never gates CI. Needs an ICD.
    "upload_throughput_bench": {
      "type": "executable",
      "sources": [ "src/upload_throughput_bench.c3" ]
    },
    // Advisory async-compute/graphics overlap observation: chained vs
    // independent submission across queues, timestamp-pool-backed where
    // supported; executable so it never gates CI. Needs an ICD — pin
    // lavapipe via VK_DRIVER_FILES; single-queue adapters degrade to a
    // topology-printed not-applicable verdict.
    "async_overlap_bench": {
      "type": "executable",
      "sources": [ "src/async_overlap_bench.c3", "src/overlap_abi.c3" ]
    },
    "vk_core": {
      "type": "test",
      "sources": [
        "src/test_vk_device_desc.c3",
        "src/test_vk_dispatch.c3",
        "src/test_vk_features.c3",
        "src/test_vk_runtime.c3",
        "src/test_vk_bootstrap.c3",
        "src/test_vk_public_contract.c3",
        "src/test_vk_result_mapping.c3",
        "src/test_vk_command_allocator.c3",
        "src/test_vk_vma_allocator.c3",
        "src/test_vk_buffer.c3",
        "src/test_vk_mapped_gpu_span.c3",
        "src/test_vk_buffer_table.c3",
        "src/test_vk_span_resolver.c3",
        "src/test_vk_allocation.c3",
        "src/submitted_command_fixture.c3",
        "src/test_vk_command_submit.c3",
        "src/test_vk_command_validation.c3",
        "src/test_vk_render_pass_validation.c3",
        "src/test_vk_texture_transition.c3",
        "src/test_vk_texture.c3",
        "src/test_vk_dedicated_texture.c3",
        "src/test_vk_sparse_texture.c3",
        "src/test_attachment_view_table.c3",
        "src/test_vk_descriptor_heap.c3",
        "src/test_vk_descriptor_heap_plan.c3",
        "src/test_vk_root_pointer_compute.c3",
        "src/root_pointer_abi.c3",
        "src/test_vk_texture_heap.c3",
        "src/test_vk_texture_upload.c3",
        "src/bindless_abi.c3",
        "src/offscreen_abi.c3",
        "src/test_vk_shader_reflection.c3",
        "src/test_vk_offscreen_triangle.c3",
        "src/test_vk_pipeline_cache.c3",
        "src/test_vk_pipeline_cache_io.c3",
        "src/test_vk_immediate_lifetime.c3",
        "src/test_vk_indexed_draw.c3",
        "src/test_vk_depth_attachment.c3",
        "src/test_vk_multisample_render.c3",
        "src/depth_abi.c3",
        "src/test_vk_threading.c3",
        "src/test_vk_queue_selection.c3",
        "src/test_vk_submit.c3",
        "src/test_vk_completion.c3",
        "src/test_vk_debug_report.c3",
        "src/test_vk_validation_policy.c3",
        "src/test_vk_command_policy_matrix.c3",
        "src/test_vk_timestamp_pool_table.c3",
        "src/test_vk_timestamp_commands.c3",
        "src/test_vk_timestamp_queries.c3"
      ]
    },
    "vk_sparse_texture": {
      "type": "test",
      "sources": [ "src/test_vk_sparse_texture.c3" ]
    },
    "vk_wsi": {
      "type": "test",
      "sources": [
        "src/test_vk_swapchain.c3",
        "src/test_vk_wsi_diagnostics.c3"
      ]
    },
    "vk_optional_generated_work": {
      "type": "test",
      "sources": [
        "src/test_generated_scratch.c3",
        "src/test_vk_indirect_draw.c3",
        "src/indirect_abi.c3",
        "src/generated_work_abi.c3",
        "src/root_pointer_abi.c3",
        "src/offscreen_abi.c3"
      ]
    }
  }
}
