{
  "langrev": "1",
  // Whitebox harness: compiles the library sources directly (list mirrors
  // manifest.json — c3c has no single-star glob) so no gpu.c3l resolution or
  // symlinks are needed. Bindings resolve from ../lib by real directory name.
  // Consumer-style resolution is exercised by the gpu.c3l-samples repo.
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "../lib" ],
  "dependencies": [ "vk", "vma", "spvreflect" ],
  // The vendored VulkanMemoryAllocator.lib is built /MD (release CRT); linking
  // c3c's dynamic-debug default against it mixes debug/release STL DLLs, which
  // crashes in VMA's std::mutex when the runtimes drift apart.
  "wincrt": "dynamic",
  "sources": [
    "../gpu/gpu.c3", "../gpu/types.c3", "../gpu/faults.c3",
    "../gpu/runtime.c3", "../gpu/adapter.c3", "../gpu/device.c3",
    "../gpu/device_request.c3", "../gpu/caps.c3",
    "../gpu/device_support.c3",
    "../gpu/surface.c3", "../gpu/surface/**",
    "../gpu/memory.c3", "../gpu/buffer.c3", "../gpu/texture.c3", "../gpu/descriptor_heap.c3",
    "../gpu/pipeline.c3", "../gpu/command.c3", "../gpu/sync.c3", "../gpu/queue.c3",
    "../gpu/swapchain.c3", "../gpu/debug.c3", "../gpu/shader_abi.c3", "../gpu/vk/**"
  ],
  "output": "build",
  "targets": {
    "smoke": {
      "type": "executable",
      "sources": [ "src/smoke.c3" ]
    },
    "benchmark_info": {
      "type": "executable",
      "sources": [ "src/benchmark_info.c3" ]
    },
    "arena_allocation_bench": {
      "type": "executable",
      "sources": [ "src/arena_allocation_bench.c3" ]
    },
    // Advisory pipeline-cache lookup timing; executable so it never gates CI.
    // Needs an ICD — pin lavapipe via VK_DRIVER_FILES when running this target.
    "pipeline_cache_bench": {
      "type": "executable",
      "sources": [ "src/pipeline_cache_bench.c3" ]
    },
    // Advisory end_frame timing across four queue-topology phases; executable
    // so it never gates CI. Needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "frame_signal_bench": {
      "type": "executable",
      "sources": [ "src/frame_signal_bench.c3" ]
    },
    // Advisory begin_frame reset-loop timing; executable so it never gates
    // CI. Needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "context_reset_bench": {
      "type": "executable",
      "sources": [ "src/context_reset_bench.c3" ]
    },
    "command_record_bench": {
      "type": "executable",
      "sources": [ "src/command_record_bench.c3" ]
    },
    // Advisory two-phase creation timing across worker counts 1/2/4;
    // executable so it never gates CI. Needs an ICD — pin lavapipe via
    // VK_DRIVER_FILES.
    "resource_create_bench": {
      "type": "executable",
      "sources": [ "src/resource_create_bench.c3" ]
    },
    // Advisory texture-descriptor churn timing: singles vs batched(16) vs
    // samplers across worker counts 1/2/4; executable so it never gates CI.
    // Needs an ICD — pin lavapipe via VK_DRIVER_FILES. DB-mode phases run
    // only with GPU_C3L_RUN_DESCRIPTOR_BUFFER_E2E=1.
    "descriptor_churn_bench": {
      "type": "executable",
      "sources": [ "src/descriptor_churn_bench.c3" ]
    },
    // Advisory upload observations across worker/payload/arena combinations;
    // executable so timing never gates CI. Needs an ICD.
    "upload_throughput_bench": {
      "type": "executable",
      "sources": [ "src/upload_throughput_bench.c3", "src/upload_bench_observation.c3" ]
    },
    "upload_bench_observation": {
      "type": "test",
      "sources": [ "src/test_upload_bench_observation.c3", "src/upload_bench_observation.c3" ]
    },
    // Advisory async-compute/graphics overlap observation: chained vs
    // independent submission across queues, timestamp-pool-backed where
    // supported; executable so it never gates CI. Needs an ICD — pin
    // lavapipe via VK_DRIVER_FILES; single-queue adapters degrade to a
    // topology-printed not-applicable verdict.
    "async_overlap_bench": {
      "type": "executable",
      "sources": [ "src/async_overlap_bench.c3", "src/overlap_abi.c3" ]
    },
    "vk_device_request": {
      "type": "test",
      "sources": [ "src/test_vk_device_request.c3", "src/test_vk_dispatch.c3" ]
    },
    // Vulkan bootstrap: the feature gate needs no ICD; the create/destroy test
    // needs one — pin lavapipe via VK_DRIVER_FILES when running this target.
    "vk_bootstrap": {
      "type": "test",
      "sources": [ "src/test_vk_features.c3", "src/test_vk_runtime.c3", "src/test_vk_bootstrap.c3", "src/test_vk_public_contract.c3", "src/test_vk_result_mapping.c3", "src/test_vk_context_pools.c3", "src/root_pointer_abi.c3", "src/test_vk_vma_allocator.c3", "src/test_vk_buffer.c3", "src/test_vk_frame_arena.c3", "src/test_vk_persistent_arena.c3" ]
    },
    "vk_command": {
      "type": "test",
      "sources": [ "src/test_vk_command_submit.c3", "src/test_vk_command_validation.c3", "src/test_vk_layout_commit.c3", "src/offscreen_abi.c3" ]
    },
    "vk_texture": {
      "type": "test",
      "sources": [ "src/test_vk_texture.c3" ]
    },
    "vk_descriptor_heap": {
      "type": "test",
      "sources": [ "src/test_vk_descriptor_heap.c3" ]
    },
    "vk_root_pointer": {
      "type": "test",
      "sources": [ "src/test_vk_root_pointer_compute.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_texture_heap": {
      "type": "test",
      "sources": [ "src/test_vk_texture_heap.c3", "src/test_vk_descriptor_buffer.c3", "src/test_vk_texture_upload.c3", "src/test_vk_upload_readback.c3", "src/test_vk_transfer_arena.c3", "src/bindless_abi.c3", "src/offscreen_abi.c3" ]
    },
    "vk_shader_reflection": {
      "type": "test",
      "sources": [ "src/test_vk_shader_reflection.c3" ]
    },
    "vk_offscreen": {
      "type": "test",
      "sources": [ "src/test_vk_offscreen_triangle.c3", "src/offscreen_abi.c3" ]
    },
    "vk_swapchain": {
      "type": "test",
      "sources": [ "src/test_vk_swapchain.c3", "src/test_vk_wsi_diagnostics.c3" ]
    },
    "vk_pipeline_cache": {
      "type": "test",
      "sources": [ "src/test_vk_pipeline_cache.c3", "src/test_vk_pipeline_cache_io.c3", "src/test_vk_deferred_destroy.c3", "src/offscreen_abi.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_indirect": {
      "type": "test",
      "sources": [ "src/test_vk_indirect_draw.c3", "src/indirect_abi.c3", "src/root_pointer_abi.c3", "src/offscreen_abi.c3" ]
    },
    // Indexed-draw pixel equivalence; needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "vk_indexed_draw": {
      "type": "test",
      "sources": [ "src/test_vk_indexed_draw.c3" ]
    },
    "vk_depth": {
      "type": "test",
      "sources": [ "src/test_vk_depth_attachment.c3", "src/depth_abi.c3" ]
    },
    "vk_threading": {
      "type": "test",
      "sources": [ "src/test_vk_threading.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_queue": {
      "type": "test",
      "sources": [ "src/test_vk_queue_selection.c3", "src/test_vk_submit_stats.c3" ]
    },
    "vk_debug": {
      "type": "test",
      "sources": [ "src/test_vk_debug_report.c3" ]
    }
  }
}
