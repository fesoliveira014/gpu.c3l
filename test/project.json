{
  "langrev": "1",
  // Whitebox harness: compiles the library sources directly (list mirrors
  // manifest.json — c3c has no single-star glob) so no gpu.c3l resolution or
  // symlinks are needed. Bindings resolve from ../lib by real directory name.
  // Consumer-style resolution is exercised by the gpu.c3l-samples repo.
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ "../lib" ],
  "dependencies": [ "vk", "vma", "spvreflect" ],
  "sources": [
    "../gpu.c3", "../types.c3", "../faults.c3", "../device.c3", "../caps.c3",
    "../memory.c3", "../buffer.c3", "../texture.c3", "../descriptor_heap.c3",
    "../pipeline.c3", "../command.c3", "../sync.c3", "../queue.c3",
    "../swapchain.c3", "../debug.c3", "../shader_abi.c3", "../vk/**"
  ],
  "output": "build",
  "targets": {
    // Link-proof: builds the gpu -> vma -> vk graph + native libs.
    "smoke": {
      "type": "executable",
      "sources": [ "src/smoke.c3" ]
    },
    // Advisory pipeline-cache lookup timing; executable so it never gates CI.
    // Needs an ICD — pin lavapipe via VK_DRIVER_FILES when running this target.
    "pipeline_cache_bench": {
      "type": "executable",
      "sources": [ "src/pipeline_cache_bench.c3" ]
    },
    // Advisory end_frame timing across four queue-topology phases; executable
    // so it never gates CI. Needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "frame_signal_bench": {
      "type": "executable",
      "sources": [ "src/frame_signal_bench.c3" ]
    },
    // Advisory begin_frame reset-loop timing; executable so it never gates
    // CI. Needs an ICD — pin lavapipe via VK_DRIVER_FILES.
    "context_reset_bench": {
      "type": "executable",
      "sources": [ "src/context_reset_bench.c3" ]
    },
    // Advisory two-phase creation timing across worker counts 1/2/4;
    // executable so it never gates CI. Needs an ICD — pin lavapipe via
    // VK_DRIVER_FILES.
    "resource_create_bench": {
      "type": "executable",
      "sources": [ "src/resource_create_bench.c3" ]
    },
    // Vulkan bootstrap: the feature gate needs no ICD; the create/destroy test
    // needs one — pin lavapipe via VK_DRIVER_FILES when running this target.
    "vk_bootstrap": {
      "type": "test",
      "sources": [ "src/test_vk_features.c3", "src/test_vk_bootstrap.c3", "src/root_pointer_abi.c3", "src/test_vk_vma_allocator.c3", "src/test_vk_buffer.c3", "src/test_vk_frame_arena.c3", "src/test_vk_persistent_arena.c3" ]
    },
    "vk_command": {
      "type": "test",
      "sources": [ "src/test_vk_command_submit.c3", "src/test_vk_command_validation.c3", "src/test_vk_layout_commit.c3", "src/offscreen_abi.c3" ]
    },
    "vk_texture": {
      "type": "test",
      "sources": [ "src/test_vk_texture.c3" ]
    },
    "vk_descriptor_heap": {
      "type": "test",
      "sources": [ "src/test_vk_descriptor_heap.c3" ]
    },
    "vk_root_pointer": {
      "type": "test",
      "sources": [ "src/test_vk_root_pointer_compute.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_texture_heap": {
      "type": "test",
      "sources": [ "src/test_vk_texture_heap.c3", "src/test_vk_descriptor_buffer.c3", "src/test_vk_texture_upload.c3", "src/test_vk_upload_readback.c3", "src/bindless_abi.c3" ]
    },
    "vk_shader_reflection": {
      "type": "test",
      "sources": [ "src/test_vk_shader_reflection.c3" ]
    },
    "vk_offscreen": {
      "type": "test",
      "sources": [ "src/test_vk_offscreen_triangle.c3", "src/offscreen_abi.c3" ]
    },
    "vk_swapchain": {
      "type": "test",
      "sources": [ "src/test_vk_swapchain.c3" ]
    },
    "vk_pipeline_cache": {
      "type": "test",
      "sources": [ "src/test_vk_pipeline_cache.c3", "src/test_vk_pipeline_cache_io.c3", "src/test_vk_deferred_destroy.c3", "src/offscreen_abi.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_indirect": {
      "type": "test",
      "sources": [ "src/test_vk_indirect_draw.c3", "src/indirect_abi.c3", "src/root_pointer_abi.c3", "src/offscreen_abi.c3" ]
    },
    "vk_depth": {
      "type": "test",
      "sources": [ "src/test_vk_depth_attachment.c3", "src/depth_abi.c3" ]
    },
    "vk_threading": {
      "type": "test",
      "sources": [ "src/test_vk_threading.c3", "src/root_pointer_abi.c3" ]
    },
    "vk_queue": {
      "type": "test",
      "sources": [ "src/test_vk_queue_selection.c3", "src/test_vk_submit_stats.c3" ]
    },
    "vk_debug": {
      "type": "test",
      "sources": [ "src/test_vk_debug_report.c3" ]
    }
  }
}
