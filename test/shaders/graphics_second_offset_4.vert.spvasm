OpCapability Shader
OpCapability Int64
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %pc
OpDecorate %Push Block
OpMemberDecorate %Push 0 Offset 0
OpMemberDecorate %Push 1 Offset 4
%void = OpTypeVoid
%function = OpTypeFunction %void
%u64 = OpTypeInt 64 0
%u32 = OpTypeInt 32 0
%u32_0 = OpConstant %u32 0
%u32_1 = OpConstant %u32 1
%Push = OpTypeStruct %u64 %u64
%push_ptr = OpTypePointer PushConstant %Push
%push_u64_ptr = OpTypePointer PushConstant %u64
%pc = OpVariable %push_ptr PushConstant
%main = OpFunction %void None %function
%label = OpLabel
%first_member = OpAccessChain %push_u64_ptr %pc %u32_0
%first_value = OpLoad %u64 %first_member
%second_member = OpAccessChain %push_u64_ptr %pc %u32_1
%second_value = OpLoad %u64 %second_member
OpReturn
OpFunctionEnd
