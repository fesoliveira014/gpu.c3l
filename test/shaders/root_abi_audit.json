{
  "schema_version": 1,
  "target_env": "vulkan1.3",
  "predicates": [
    {
      "property": "push block count",
      "class": "physical",
      "rationale": "The selected entry may expose no root block or one unambiguous generated root block."
    },
    {
      "property": "block offset and size",
      "class": "physical",
      "rationale": "The fixed pipeline layout pushes exactly the generated 8-byte compute or 16-byte graphics range from offset zero."
    },
    {
      "property": "member count, order, offset, and size",
      "class": "physical",
      "rationale": "Compute consumes one address and graphics consumes two distinct complete addresses at fixed offsets."
    },
    {
      "property": "64-bit scalar width",
      "class": "physical",
      "rationale": "GpuAddress is exactly 64 bits."
    },
    {
      "property": "unsigned integer kind",
      "class": "semantic",
      "rationale": "The canonical SPIR-V integer-to-physical-pointer conversion requires an unsigned integer operand."
    },
    {
      "property": "flat non-aggregate shape",
      "class": "semantic",
      "rationale": "The canonical supported GLSL path exposes each address directly; alternate reference shape requires runtime address evidence before acceptance."
    },
    {
      "property": "selected descriptor set, binding, and type",
      "class": "heap",
      "rationale": "The fixed strict heap layout cannot consume an unrelated descriptor interface."
    }
  ],
  "fixtures": [
    {
      "id": "canonical-compute",
      "source": "root_pointer.comp.glsl",
      "output": "root_pointer.comp.spv",
      "expected": "accept",
      "isolates": "one flat unsigned 64-bit root"
    },
    {
      "id": "canonical-vertex",
      "source": "offscreen.vert.glsl",
      "output": "offscreen.vert.spv",
      "expected": "accept",
      "isolates": "complete graphics root with vertex use"
    },
    {
      "id": "canonical-fragment",
      "source": "offscreen.frag.glsl",
      "output": "offscreen.frag.spv",
      "expected": "accept",
      "isolates": "complete graphics root with fragment use"
    },
    {
      "id": "no-push",
      "source": "no_push.comp.glsl",
      "output": "no_push.comp.spv",
      "expected": "accept",
      "isolates": "selected entry without a push block"
    },
    {
      "id": "renamed-member",
      "source": "root_renamed.comp.glsl",
      "output": "root_renamed.comp.spv",
      "expected": "accept",
      "isolates": "names are not ABI"
    },
    {
      "id": "signed-root",
      "source": "root_signed.comp.glsl",
      "output": "root_signed.comp.spv",
      "expected": "reject",
      "isolates": "signedness semantic policy"
    },
    {
      "id": "direct-reference-root",
      "source": "root_ref.comp.glsl",
      "output": "root_ref.comp.spv",
      "expected": "reject",
      "isolates": "evidence-gated physical buffer reference"
    },
    {
      "id": "nested-root",
      "source": "root_nested.comp.glsl",
      "output": "root_nested.comp.spv",
      "expected": "reject",
      "isolates": "aggregate semantic policy"
    },
    {
      "id": "narrow-root",
      "source": "root_u32.comp.glsl",
      "output": "root_u32.comp.spv",
      "expected": "reject",
      "isolates": "scalar width"
    },
    {
      "id": "wrong-block-offset",
      "source": "root_wrong_offset.comp.spvasm",
      "output": "root_wrong_offset.comp.spv",
      "expected": "reject",
      "isolates": "block offset"
    },
    {
      "id": "extra-member",
      "source": "root_two_members.comp.glsl",
      "output": "root_two_members.comp.spv",
      "expected": "reject",
      "isolates": "member count"
    },
    {
      "id": "partial-graphics-root",
      "source": "graphics_size_8.vert.spvasm",
      "output": "graphics_size_8.vert.spv",
      "expected": "reject",
      "isolates": "complete graphics block size"
    },
    {
      "id": "reversed-graphics-root",
      "source": "graphics_reversed_members.vert.spvasm",
      "output": "graphics_reversed_members.vert.spv",
      "expected": "reject",
      "isolates": "graphics member order"
    },
    {
      "id": "foreign-descriptor-set",
      "source": "bad_set.comp.glsl",
      "output": "bad_set.comp.spv",
      "expected": "reject",
      "isolates": "strict heap set"
    },
    {
      "id": "foreign-descriptor-binding",
      "source": "bad_binding.comp.glsl",
      "output": "bad_binding.comp.spv",
      "expected": "reject",
      "isolates": "strict heap binding and type"
    }
  ]
}
