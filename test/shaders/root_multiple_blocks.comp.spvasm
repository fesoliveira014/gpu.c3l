OpCapability Shader
OpCapability Int64
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %first_pc %second_pc
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %FirstPush Block
OpMemberDecorate %FirstPush 0 Offset 0
OpDecorate %SecondPush Block
OpMemberDecorate %SecondPush 0 Offset 0
%void = OpTypeVoid
%function = OpTypeFunction %void
%u64 = OpTypeInt 64 0
%u32 = OpTypeInt 32 0
%u32_0 = OpConstant %u32 0
%FirstPush = OpTypeStruct %u64
%SecondPush = OpTypeStruct %u64
%first_ptr = OpTypePointer PushConstant %FirstPush
%second_ptr = OpTypePointer PushConstant %SecondPush
%push_u64_ptr = OpTypePointer PushConstant %u64
%first_pc = OpVariable %first_ptr PushConstant
%second_pc = OpVariable %second_ptr PushConstant
%main = OpFunction %void None %function
%label = OpLabel
%first_member = OpAccessChain %push_u64_ptr %first_pc %u32_0
%first_value = OpLoad %u64 %first_member
%second_member = OpAccessChain %push_u64_ptr %second_pc %u32_0
%second_value = OpLoad %u64 %second_member
OpReturn
OpFunctionEnd
