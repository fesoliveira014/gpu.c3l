abi depth;

root SampleDepthRoot {
    GpuAddress   out_gpu;
    TextureIndex texture_index;
    SamplerIndex sampler_index;
    float        u;
    float        v;
}

root ShadowProbeRoot {
    GpuAddress   out_gpu;
    TextureIndex depth_texture;
    SamplerIndex shadow_sampler;
    float        u;
    float        v;
    float        ref_lo;
    float        ref_hi;
    uint         _pad0;
    uint         _pad1;
}
