abi bindless;

const uint HEAP_TILE = 8;

root WriteRoot {
    TextureIndex texture_index;
    uint         width;
    uint         height;
    uint         _pad0;
}

root SampleRoot {
    GpuAddress   output_gpu;
    TextureIndex texture_index;
    SamplerIndex sampler_index;
    uint         width;
    uint         height;
}

root VolumeHeapRoot {
    GpuAddress   output_gpu;
    TextureIndex texture_2d_index;
    TextureIndex texture_3d_index;
    SamplerIndex sampler_index;
    uint         width;
    uint         height;
    uint         depth;
}

root CubeHeapRoot {
    GpuAddress   output_gpu;
    TextureIndex cube_index;
    TextureIndex face_index;
    SamplerIndex nearest_sampler;
    SamplerIndex linear_sampler;
}
