module gen_shader_abi;

<* Emit the GLSL side as one self-contained include: guard, required
   extensions, typed constants, plain structs for struct/push/extern kinds,
   and buffer_reference blocks for root kinds. Semantic types lower to their
   base scalar; no push_constant binding block is emitted. *>
fn void emit_glsl(Schema* schema, TypeTable* types, DString* out) {
    out.appendf("// Generated by gen_shader_abi from the '%s' ABI schema - do not edit.\n", schema.abi_name);
    out.append("#ifndef ");
    append_guard(schema.abi_name, out);
    out.append("\n#define ");
    append_guard(schema.abi_name, out);
    out.append("\n");

    bool has_root = false;
    bool has_int64 = false;
    foreach (&decl : schema.structs) {
        if (decl.kind == DeclKind.ROOT) has_root = true;
        foreach (&field : decl.fields) {
            TypeInfo info = types.entries.get(field.type_name)!!;
            if (info.glsl_name == "uint64_t") has_int64 = true;
        }
    }
    foreach (&decl : schema.consts) {
        if (decl.type_name == "u64") has_int64 = true;
    }
    if (has_root || has_int64) out.append("\n");
    if (has_root) {
        out.append("#extension GL_EXT_buffer_reference : require\n");
        out.append("#extension GL_EXT_buffer_reference2 : require\n");
    }
    if (has_int64) out.append("#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require\n");

    if (schema.consts.len() > 0) out.append("\n");
    foreach (&decl : schema.consts) {
        String glsl_type;
        String suffix;
        switch (decl.type_name) {
            case "uint":  glsl_type = "uint";     suffix = "u";
            case "u64":   glsl_type = "uint64_t"; suffix = "ul";
            case "int":   glsl_type = "int";      suffix = "";
            case "float": glsl_type = "float";    suffix = "";
            default: unreachable();
        }
        out.appendf("const %s %s = %s%s%s;\n", glsl_type, decl.name, decl.negative ? "-" : "", decl.value, suffix);
    }

    foreach (&decl : schema.structs) {
        out.append("\n");
        if (decl.kind == DeclKind.ROOT) {
            out.appendf("layout(buffer_reference, std430, buffer_reference_align = %d) buffer %s {\n", decl.alignment, decl.name);
        } else {
            out.appendf("struct %s {\n", decl.name);
        }
        foreach (&field : decl.fields) {
            TypeInfo info = types.entries.get(field.type_name)!!;
            out.appendf("    %s %s;\n", info.glsl_name, field.name);
        }
        out.append("};\n");
    }

    out.append("\n#endif\n");
}

fn void append_guard(String abi_name, DString* out) {
    foreach (c : abi_name) {
        out.append_char(c >= 'a' && c <= 'z' ? c - 'a' + 'A' : c);
    }
    out.append("_SHADER_ABI_GLSL");
}
