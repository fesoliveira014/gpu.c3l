module gen_shader_abi;

<* Emit the C3 side: typedefs, constants, struct declarations in schema order,
   and a size + per-field-offset assert block for every struct (extern structs
   get the asserts only). *>
fn void emit_c3(Schema* schema, TypeTable* types, String module_name, DString* out) {
    out.appendf("// Generated by gen_shader_abi from the '%s' ABI schema - do not edit.\n", schema.abi_name);
    out.appendf("module %s;\n", module_name);
    if (module_name != "gpu" && module_name != "gpu::compat") {
        out.append("\nimport gpu::compat;\n");
    }

    foreach (&decl : schema.types) {
        TypeInfo base = types.entries.get(decl.base_name)!!;
        out.appendf("\ntypedef %s = ", decl.name);
        append_c3_type(out, base, module_name);
        out.append(";\n");
    }

    if (schema.consts.len() > 0) out.append("\n");
    foreach (&decl : schema.consts) {
        TypeInfo info = types.entries.get(decl.type_name)!!;
        out.append("const ");
        append_c3_type(out, info, module_name);
        out.appendf(" %s = %s%s;\n", decl.name, decl.negative ? "-" : "", decl.value);
    }

    foreach (&decl : schema.structs) {
        out.append("\n");
        if (decl.kind != DeclKind.EXTERN_STRUCT) {
            usz width = c3_type_width(decl, types, module_name);
            out.appendf("struct %s {\n", decl.name);
            foreach (&field : decl.fields) {
                TypeInfo info = types.entries.get(field.type_name)!!;
                out.append("    ");
                append_c3_type(out, info, module_name);
                for (usz i = c3_type_len(info, module_name); i < width; i++) out.append(" ");
                out.appendf(" %s;\n", field.name);
            }
            out.append("}\n");
        }
        out.appendf("$assert %s::size == %d;\n", decl.name, decl.size);
        foreach (&field : decl.fields) {
            out.appendf("$assert $reflect(%s.%s).offset == %d;\n", decl.name, field.name, field.offset);
        }
    }
}

fn bool c3_type_is_external(TypeInfo info, String module_name) {
    return module_name != "gpu"
        && module_name != "gpu::compat"
        && (info.kind == TypeKind.VECTOR || info.kind == TypeKind.SEMANTIC);
}

fn usz c3_type_len(TypeInfo info, String module_name) {
    return info.c3_name.len + (c3_type_is_external(info, module_name) ? "gpu::compat::".len : 0);
}

fn void append_c3_type(DString* out, TypeInfo info, String module_name) {
    if (c3_type_is_external(info, module_name)) out.append("gpu::compat::");
    out.append(info.c3_name);
}

fn usz c3_type_width(StructDecl* decl, TypeTable* types, String module_name) {
    usz width = 0;
    foreach (&field : decl.fields) {
        TypeInfo info = types.entries.get(field.type_name)!!;
        usz len = c3_type_len(info, module_name);
        if (len > width) width = len;
    }
    return width;
}
