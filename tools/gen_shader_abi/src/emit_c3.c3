module gen_shader_abi;

<* Emit the C3 side: typedefs, constants, struct declarations in schema order,
   and a size + per-field-offset assert block for every struct (extern structs
   get the asserts only). *>
fn void emit_c3(Schema* schema, TypeTable* types, String module_name, DString* out) {
    out.appendf("// Generated by gen_shader_abi from the '%s' ABI schema - do not edit.\n", schema.abi_name);
    out.appendf("module %s;\n", module_name);
    if (module_name != "gpu") out.append("\nimport gpu;\n");

    foreach (&decl : schema.types) {
        TypeInfo base = types.entries.get(decl.base_name)!!;
        out.appendf("\ntypedef %s = %s;\n", decl.name, base.c3_name);
    }

    if (schema.consts.len() > 0) out.append("\n");
    foreach (&decl : schema.consts) {
        TypeInfo info = types.entries.get(decl.type_name)!!;
        out.appendf("const %s %s = %s%s;\n", info.c3_name, decl.name, decl.negative ? "-" : "", decl.value);
    }

    foreach (&decl : schema.structs) {
        out.append("\n");
        if (decl.kind != DeclKind.EXTERN_STRUCT) {
            usz width = c3_type_width(decl, types);
            out.appendf("struct %s {\n", decl.name);
            foreach (&field : decl.fields) {
                TypeInfo info = types.entries.get(field.type_name)!!;
                out.appendf("    %s", info.c3_name);
                for (usz i = info.c3_name.len; i < width; i++) out.append(" ");
                out.appendf(" %s;\n", field.name);
            }
            out.append("}\n");
        }
        out.appendf("$assert %s::size == %d;\n", decl.name, decl.size);
        foreach (&field : decl.fields) {
            out.appendf("$assert $reflect(%s.%s).offset == %d;\n", decl.name, field.name, field.offset);
        }
    }
}

fn usz c3_type_width(StructDecl* decl, TypeTable* types) {
    usz width = 0;
    foreach (&field : decl.fields) {
        TypeInfo info = types.entries.get(field.type_name)!!;
        if (info.c3_name.len > width) width = info.c3_name.len;
    }
    return width;
}
