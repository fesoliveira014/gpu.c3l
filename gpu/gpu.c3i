module gpu;

import gpu::internal @public;

// Public interface for consumers of gpu.c3l.

// ---- Handles, shared values, and faults ----

// Shared-ABI vector aliases: plain SIMD vectors (element-aligned in structs;
// std430 vector alignment comes from explicit padding validated by the ABI
// generator, not from these types).
alias Vec2f = float[<2>];

// Same shared-ABI rules as Vec2f.
alias Vec4f = float[<4>];

// Same shared-ABI rules as Vec2f.
alias Vec4u = uint[<4>];
$assert Vec2f::size == 8;
$assert Vec4f::size == 16;
$assert Vec4u::size == 16;

// Device handles are compact registry tokens. Device-owned resources also
// carry an exact owner identity so coincident local slots cannot alias.

bitstruct Device : ulong {
    uint index      : 0..31;
    uint generation : 32..55;
    uint reserved   : 56..63;
}

// Fixed-width shader-visible heap values. Value zero is the invalid sentinel;
// live values encode the zero-based backend slot plus one and carry no CPU
// ownership or generation metadata.
bitstruct TextureIndex : uint {
    uint value : 0..31;
}

bitstruct SamplerIndex : uint {
    uint value : 0..31;
}

bitstruct AccelerationStructureIndex : uint {
    uint value : 0..31;
}

<* Owning token for device-scoped generic GPU data. *>
struct GpuAllocation {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert GpuAllocation::size <= ulong::size * 2;

struct TextureHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert TextureHandle::size <= ulong::size * 2;

<* Owning token for one bottom- or top-level acceleration structure. *>
struct AccelerationStructureHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert AccelerationStructureHandle::size <= ulong::size * 2;

struct AttachmentViewHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert AttachmentViewHandle::size <= ulong::size * 2;

<* Owning CPU token for one published texture view. `index` is the raw value
   stored in shader data; ownership and generation stay CPU-only. *>
struct TextureView {
    ulong        owner;
    TextureIndex index;
    uint         generation;
}
$assert TextureView::size <= ulong::size * 2;

<* Owning CPU token for one published top-level acceleration structure. *>
struct AccelerationStructureView {
    ulong                      owner;
    AccelerationStructureIndex index;
    uint                       generation;
}
$assert AccelerationStructureView::size <= ulong::size * 2;

struct PipelineHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert PipelineHandle::size <= ulong::size * 2;

struct SwapchainHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert SwapchainHandle::size <= ulong::size * 2;

<* Generation-checked identity for a command allocator owned by one device. *>
struct CommandAllocatorHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert CommandAllocatorHandle::size <= ulong::size * 2;

struct TimestampPoolHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert TimestampPoolHandle::size <= ulong::size * 2;

bitstruct Runtime : ulong {
    uint index      : 0..31;
    uint generation : 32..55;
    uint reserved   : 56..63;
}

<* A recording token whose fields are library-owned. Never construct, mutate,
   persist, or serialize it. Successful end consumes it and every alias. *>
struct CommandList {
    gpu::internal::vk::CommandRecord* record;
    uint                              generation;
    uint                              device_identity;
}

// gpu.c3l supports linux-x64 and windows-x64; this is an exact 16-byte ABI.
$assert CommandList::size == ulong::size * 2;

<* An executable token whose fields are library-owned. Never construct,
   mutate, persist, or serialize it. Submit or discard consumes every alias. *>
struct ExecutableCommandList {
    gpu::internal::vk::CommandRecord* record;
    uint                              generation;
    uint                              device_identity;
}
$assert ExecutableCommandList::size == ulong::size * 2;

const Device                 DEVICE_INVALID                   = {};

const GpuAllocation          GPU_ALLOCATION_INVALID           = {};

const TextureHandle          TEXTURE_HANDLE_INVALID           = {};

const AccelerationStructureHandle ACCELERATION_STRUCTURE_HANDLE_INVALID = {};

const AttachmentViewHandle   ATTACHMENT_VIEW_HANDLE_INVALID   = {};

const TextureView            TEXTURE_VIEW_INVALID             = {};

const AccelerationStructureView ACCELERATION_STRUCTURE_VIEW_INVALID = {};

const PipelineHandle         PIPELINE_HANDLE_INVALID          = {};

const SwapchainHandle        SWAPCHAIN_HANDLE_INVALID         = {};

const CommandAllocatorHandle COMMAND_ALLOCATOR_HANDLE_INVALID = {};

const TimestampPoolHandle    TIMESTAMP_POOL_HANDLE_INVALID    = {};

const TextureIndex TEXTURE_INDEX_INVALID = {};

const SamplerIndex SAMPLER_INDEX_INVALID = {};

const AccelerationStructureIndex ACCELERATION_STRUCTURE_INDEX_INVALID = {};

const Runtime RUNTIME_INVALID = {};

// Public fault set. Categories describe causes, not whole fault values: one
// value can report an always-checked cause, a FULL diagnostic, or a runtime
// failure. docs/api/index.md carries the complete cause classification.
faultdef
    // Runtime failure: the requested backend or Vulkan 1.3 driver is absent,
    // or backend creation failed.
    UNSUPPORTED_BACKEND,
    // Runtime failure: a valid capability, layer, presentation path, feature,
    // or exact semantic capacity is unavailable.
    UNSUPPORTED_FEATURE,
    // Always checked for required host-safety, safe-lowering, and cold-path
    // configuration causes; FULL also uses it for semantic diagnostics.
    INVALID_ARGUMENT,
    // Always checked: a bounded public identity is zero, stale, consumed,
    // foreign, malformed, or was never live.
    INVALID_HANDLE,
    // Always checked lifecycle/safe-snapshot cause, or runtime backend result:
    // a transition is incompatible with authoritative state, command execution
    // lacks a usable pipeline snapshot, or native surface ownership conflicts.
    INVALID_RESOURCE_STATE,
    // Runtime failure: host allocation failed.
    OUT_OF_HOST_MEMORY,
    // Runtime failure: device memory is exhausted.
    OUT_OF_DEVICE_MEMORY,
    // Runtime failure: the driver reported device loss. The affected device
    // rejects later operations; peer devices remain usable.
    DEVICE_LOST,
    // Runtime/lifecycle failure: closing state, bounded contention, or
    // incomplete work prevented progress. Safe to retry.
    DEVICE_BUSY,
    // Always checked lifecycle floor: destruction or mutation found a live
    // owner or dependent. Release it first.
    RESOURCE_IN_USE,
    // Runtime failure: a bounded public table reached capacity.
    SLOT_TABLE_FULL,
    // Runtime failure: reserved generated-work storage cannot satisfy a valid
    // recording request.
    GENERATED_SCRATCH_EXHAUSTED,
    // Runtime failure: fixed command-allocator bookkeeping cannot represent
    // valid requested work.
    COMMAND_ALLOCATOR_CAPACITY_EXCEEDED,
    // Runtime failure: no shader-visible descriptor slot is free.
    DESCRIPTOR_HEAP_FULL,
    // Runtime failure: the driver rejected pipeline creation.
    PIPELINE_CREATE_FAILED,
    // Always-checked cold-path validation or runtime backend rejection of
    // SPIR-V.
    SHADER_INVALID,
    // Runtime failure: the presentation surface disappeared.
    SURFACE_LOST,
    // Runtime failure: the swapchain no longer matches the surface; resize
    // and retry.
    SWAPCHAIN_OUT_OF_DATE,
    // Always checked for authoritative command phase and submit claims; FULL
    // also uses it for detailed command-state diagnostics.
    COMMAND_RECORDING_ERROR,
    // Runtime failure: a bounded wait elapsed or presentation progress is
    // transiently unavailable. Safe to retry with the unchanged value.
    WAIT_TIMEOUT,
    // Runtime failure: an unclassified backend/internal operation failed.
    // This does not imply device loss.
    BACKEND_ERROR;

// ---- Generated shader ABI ----

// BEGIN GENERATED SHADER ABI - do not edit.
struct RootPush {
    GpuAddress root_gpu;
}
$assert RootPush::size == 8;
$assert $reflect(RootPush.root_gpu).offset == 0;

struct GraphicsRootPush {
    GpuAddress vertex_root_gpu;
    GpuAddress fragment_root_gpu;
}
$assert GraphicsRootPush::size == 16;
$assert $reflect(GraphicsRootPush.vertex_root_gpu).offset == 0;
$assert $reflect(GraphicsRootPush.fragment_root_gpu).offset == 8;

struct AccelerationStructureInstance {
    Vec4f      transform_row_0;
    Vec4f      transform_row_1;
    Vec4f      transform_row_2;
    uint       custom_index_and_mask;
    uint       record_offset_and_flags;
    GpuAddress acceleration_structure;
}
$assert AccelerationStructureInstance::size == 64;
$assert $reflect(AccelerationStructureInstance.transform_row_0).offset == 0;
$assert $reflect(AccelerationStructureInstance.transform_row_1).offset == 16;
$assert $reflect(AccelerationStructureInstance.transform_row_2).offset == 32;
$assert $reflect(AccelerationStructureInstance.custom_index_and_mask).offset == 48;
$assert $reflect(AccelerationStructureInstance.record_offset_and_flags).offset == 52;
$assert $reflect(AccelerationStructureInstance.acceleration_structure).offset == 56;

$assert DrawIndirectCommand::size == 16;
$assert $reflect(DrawIndirectCommand.vertex_count).offset == 0;
$assert $reflect(DrawIndirectCommand.instance_count).offset == 4;
$assert $reflect(DrawIndirectCommand.first_vertex).offset == 8;
$assert $reflect(DrawIndirectCommand.first_instance).offset == 12;

$assert DrawIndexedIndirectCommand::size == 20;
$assert $reflect(DrawIndexedIndirectCommand.index_count).offset == 0;
$assert $reflect(DrawIndexedIndirectCommand.instance_count).offset == 4;
$assert $reflect(DrawIndexedIndirectCommand.first_index).offset == 8;
$assert $reflect(DrawIndexedIndirectCommand.vertex_offset).offset == 12;
$assert $reflect(DrawIndexedIndirectCommand.first_instance).offset == 16;

$assert DispatchIndirectCommand::size == 12;
$assert $reflect(DispatchIndirectCommand.x).offset == 0;
$assert $reflect(DispatchIndirectCommand.y).offset == 4;
$assert $reflect(DispatchIndirectCommand.z).offset == 8;

$assert TraceRaysIndirectCommand::size == 12;
$assert $reflect(TraceRaysIndirectCommand.width).offset == 0;
$assert $reflect(TraceRaysIndirectCommand.height).offset == 4;
$assert $reflect(TraceRaysIndirectCommand.depth).offset == 8;

$assert TraceRaysIndirectCommand2::size == 104;
$assert $reflect(TraceRaysIndirectCommand2.ray_generation_record_address).offset == 0;
$assert $reflect(TraceRaysIndirectCommand2.ray_generation_record_size).offset == 8;
$assert $reflect(TraceRaysIndirectCommand2.miss_table_address).offset == 16;
$assert $reflect(TraceRaysIndirectCommand2.miss_table_size).offset == 24;
$assert $reflect(TraceRaysIndirectCommand2.miss_table_stride).offset == 32;
$assert $reflect(TraceRaysIndirectCommand2.hit_table_address).offset == 40;
$assert $reflect(TraceRaysIndirectCommand2.hit_table_size).offset == 48;
$assert $reflect(TraceRaysIndirectCommand2.hit_table_stride).offset == 56;
$assert $reflect(TraceRaysIndirectCommand2.callable_table_address).offset == 64;
$assert $reflect(TraceRaysIndirectCommand2.callable_table_size).offset == 72;
$assert $reflect(TraceRaysIndirectCommand2.callable_table_stride).offset == 80;
$assert $reflect(TraceRaysIndirectCommand2.width).offset == 88;
$assert $reflect(TraceRaysIndirectCommand2.height).offset == 92;
$assert $reflect(TraceRaysIndirectCommand2.depth).offset == 96;
$assert $reflect(TraceRaysIndirectCommand2._pad0).offset == 100;

$assert AccelerationStructureIndirectBuildRange::size == 16;
$assert $reflect(AccelerationStructureIndirectBuildRange.primitive_count).offset == 0;
$assert $reflect(AccelerationStructureIndirectBuildRange.primitive_offset).offset == 4;
$assert $reflect(AccelerationStructureIndirectBuildRange.first_vertex).offset == 8;
$assert $reflect(AccelerationStructureIndirectBuildRange.transform_offset).offset == 12;

struct GeneratedDrawRecord {
    GpuAddress          vertex_root_gpu;
    GpuAddress          fragment_root_gpu;
    DrawIndirectCommand arguments;
}
$assert GeneratedDrawRecord::size == 32;
$assert $reflect(GeneratedDrawRecord.vertex_root_gpu).offset == 0;
$assert $reflect(GeneratedDrawRecord.fragment_root_gpu).offset == 8;
$assert $reflect(GeneratedDrawRecord.arguments).offset == 16;

struct GeneratedDrawIndexedRecord {
    GpuAddress                 vertex_root_gpu;
    GpuAddress                 fragment_root_gpu;
    DrawIndexedIndirectCommand arguments;
    uint                       _pad0;
}
$assert GeneratedDrawIndexedRecord::size == 40;
$assert $reflect(GeneratedDrawIndexedRecord.vertex_root_gpu).offset == 0;
$assert $reflect(GeneratedDrawIndexedRecord.fragment_root_gpu).offset == 8;
$assert $reflect(GeneratedDrawIndexedRecord.arguments).offset == 16;
$assert $reflect(GeneratedDrawIndexedRecord._pad0).offset == 36;

struct GeneratedDispatchRecord {
    GpuAddress              root_gpu;
    DispatchIndirectCommand arguments;
    uint                    _pad0;
}
$assert GeneratedDispatchRecord::size == 24;
$assert $reflect(GeneratedDispatchRecord.root_gpu).offset == 0;
$assert $reflect(GeneratedDispatchRecord.arguments).offset == 8;
$assert $reflect(GeneratedDispatchRecord._pad0).offset == 20;
// END GENERATED SHADER ABI

// ---- Runtime and devices ----

<* Queue a command list records for and submits on. *>
enum QueueKind : int {
    GRAPHICS,
    // Its own queue only when caps.async_compute; otherwise aliases GRAPHICS.
    COMPUTE,
    // May map to a dedicated transfer family.
    TRANSFER,
}

struct TimestampCaps {
    QueueRoles queues;
    uint       graphics_valid_bits;
    uint       compute_valid_bits;
    uint       transfer_valid_bits;
    float      period_ns;
}

<* Sparse texture behavior enabled on the created device. A dimension is usable
   only when its flag is set and `binding_queues` names a selected queue. With
   `nonresident_strict`, nonresident reads return zero and writes are discarded. *>
struct SparseTextureCaps {
    bool       image_2d;
    bool       image_3d;
    bool       nonresident_strict;
    QueueRoles binding_queues;
}

<* Shared acceleration-structure support and limits. `indirect_build` requires
   both the optional feature and command procedure. The zero value means the
   device did not enable acceleration structures. *>
struct AccelerationStructureCaps {
    bool enabled;
    bool indirect_build;
    uint heap_capacity;
    uint max_geometry_count;
    uint max_primitive_count;
    uint max_instance_count;
    usz  scratch_alignment;
}

<* Shader ray-query support enabled independently of direct tracing. *>
struct RayQueryCaps {
    bool enabled;
}

<* Ray-tracing pipeline support, launch limits, and caller-owned SBT packing
   requirements. The zero value means the feature was not enabled. *>
struct RayTracingPipelineCaps {
    bool enabled;
    bool indirect_dispatch;
    bool indirect2_dispatch;
    uint max_recursion_depth;
    uint max_ray_dispatch_invocation_count;
    Vec3u max_ray_dispatch_dimensions;
    uint shader_group_handle_size;
    uint shader_group_handle_alignment;
    uint shader_group_base_alignment;
    uint max_shader_group_stride;
    uint max_hit_attribute_size;
}

<* Capabilities of the created device. Query with get_device_caps instead of
   hardcoding limits. *>
struct DeviceCaps {
    bool presentation_enabled;
    bool draw_indirect_count;
    // GPU-written root records and work arguments can execute without host
    // readback or CPU-loop emulation.
    bool generated_work;
    bool async_compute;
    QueueRoles queues;
    // Optional non-solid triangle rasterization through PolygonMode.LINE.
    bool line_polygon_mode;
    TimestampCaps timestamps;
    AccelerationStructureCaps acceleration_structures;
    RayQueryCaps ray_queries;
    RayTracingPipelineCaps ray_tracing_pipelines;
    // Configured semantic heap capacity, not the hardware maximum.
    uint texture_heap_capacity;
    // Configured semantic heap capacity, not the hardware maximum.
    uint sampler_heap_capacity;
    // Effective MRT limit: the lesser of the library and selected device caps.
    uint max_color_attachments;
    // Raw selected-device limit for one Vulkan push-constant range.
    uint max_push_constant_size;
    // Selected-device direct-dispatch work-group count limit per axis.
    Vec3u max_compute_work_group_count;
    // Selected-device limit for one multi-draw indirect command.
    uint max_draw_indirect_count;
    // Selected-device limit for one generated-work execution.
    uint max_generated_work_count;
    usz  min_uniform_alignment;
    usz  min_storage_alignment;
    usz  min_texel_buffer_alignment;
    // Maximum absolute SamplerDesc.mip_lod_bias.
    float max_sampler_lod_bias;
    // 0 means anisotropic filtering is unsupported.
    float max_sampler_anisotropy;
    SparseTextureCaps sparse_textures;
}

<* Selects library contract behavior; this is independent of Vulkan validation
   layers.
   Preconditions: valid callers satisfy operation contracts under every policy.
   Always checked: token device identity, record generation, authoritative
   phase, host safety, safe lowering, lifecycle integrity, cold paths, and
   runtime results.
   FULL diagnostics: detailed command semantic misuse and resource lifetime
   tracking.
   Runtime failures: valid callers may receive documented faults in every policy. *>
enum ContractValidation : int {
    // Trusted command recording with the mandatory always-checked floor.
    TRUSTED,
    // FULL command tables with semantic diagnostics and lifetime tracking.
    FULL,
}

<* Runtime discovery configuration. A zero-initialized value selects TRUSTED,
   which keeps lifetime tracking and Vulkan validation layers off. *>
struct RuntimeDesc {
    ContractValidation   contract_validation;
    bool                 enable_vulkan_validation;
    bool                 enable_debug_names;
    uint                 texture_heap_capacity;
    uint                 sampler_heap_capacity;
    uint                 texture_capacity;
    uint                 pipeline_capacity;
    // Borrowed input copied by create_runtime for later device creation.
    char[]                pipeline_cache_data;
    ZString               application_name;
    DebugMessageCallback  debug_callback;
    void*                 debug_user_data;
    uint                  acceleration_structure_heap_capacity;
}

enum AdapterClass : int {
    OTHER,
    INTEGRATED,
    DISCRETE,
    VIRTUAL,
    SOFTWARE,
}

bitstruct Adapter : ulong {
    ushort adapter_index      : 0..15;
    ushort runtime_index      : 16..31;
    uint   runtime_generation : 32..55;
    uint   reserved           : 56..63;
}

const Adapter ADAPTER_INVALID = {};

struct AdapterMemoryInfo {
    ulong device_local_bytes;
    ulong host_visible_bytes;
}

struct AdapterQueueInfo {
    QueueRoles available;
}

struct AdapterLimits {
    uint  max_texture_dimension_2d;
    uint  max_texture_dimension_3d;
    uint  max_texture_array_layers;
    uint  max_color_attachments;
    uint  max_push_constant_size;
    Vec3u max_compute_work_group_count;
    uint  max_draw_indirect_count;
}

<* Cached semantic data. name is a borrowed read-only view until runtime destruction. *>
struct AdapterInfo {
    String            name;
    uint              vendor_id;
    uint              device_id;
    AdapterClass      device_class;
    AdapterMemoryInfo memory;
    AdapterQueueInfo  queues;
    AdapterLimits     limits;
}

struct BackendVersion {
    uint major;
    uint minor;
    uint patch;
}

<* Backend diagnostics. Strings are borrowed read-only views until runtime destruction. *>
struct AdapterDiagnostics {
    String         backend_name;
    BackendVersion backend_version;
    String         driver_name;
    String         driver_info;
    uint           driver_version;
}

<* Allocation-free view of one runtime's borrowed adapters. *>
struct AdapterList {
    Runtime runtime;
    uint    count;
}

<* Runtime-owned platform surface token. *>
bitstruct Surface : ulong {
    uint index      : 0..31;
    uint generation : 32..55;
    uint reserved   : 56..63;
}

const Surface SURFACE_INVALID = {};

const Queue QUEUE_INVALID = {};

$assert(CompletionPoint::size <= ulong::size * 2);

<* Semantic roles supported by one selected queue. *>
bitstruct QueueRoles : uint {
    bool graphics : 0;
    bool compute  : 1;
    bool transfer : 2;
}

<* Device-owned selected queue token. Copy or compare it as a whole; use
   get_queue_info to inspect its identity and supported roles. *>
struct Queue {
    Device     device;
    uint       id;
    QueueRoles roles;
}

<* Stable device-local identity and supported roles for a live queue. *>
struct QueueInfo {
    uint       id;
    QueueRoles roles;
}

<* Semantic queues required at device creation. A marked distinct role must be
   required and may not alias another required role. When `single_queue` is
   true, every required role and presentation must use one exact native queue
   identity; `distinct_roles` must be empty. *>
struct QueueRequest {
    QueueRoles required;
    QueueRoles distinct_roles;
    bool       single_queue;
}

<* Plain semantic requirements for device creation. A zero value selects the
   documented default queues, no presentation surface, and no sparse textures.
   Sparse textures require core 2D or 3D residency and a selected semantic
   queue capable of sparse binding. *>
struct DeviceDesc {
    Surface      surface;
    QueueRequest queues;
    bool         enable_sparse_textures;
    bool         enable_ray_queries;
    bool         enable_ray_tracing_pipelines;
}

<* Result of a read-only semantic support query. unmet_requirement is a
   borrowed static label when supported is false. *>
struct DeviceSupport {
    bool   supported;
    String unmet_requirement;
}

// ---- Memory and resources ----

enum AccelerationStructureKind : int {
    BOTTOM_LEVEL,
    TOP_LEVEL,
}

enum AccelerationStructureGeometryKind : int {
    TRIANGLES,
    AABBS,
}

enum AccelerationStructureIndexType : int {
    NONE,
    U16,
    U32,
}

bitstruct AccelerationStructureBuildFlags : uint {
    bool allow_update      : 0;
    bool prefer_fast_trace : 1;
    bool prefer_fast_build : 2;
    bool minimize_memory   : 3;
}

bitstruct AccelerationStructureGeometryFlags : uint {
    bool opaque : 0;
}

bitstruct AccelerationStructureInstanceFlags : uint {
    bool triangle_cull_disable : 0;
    bool triangle_facing_flip  : 1;
    bool force_opaque          : 2;
    bool force_non_opaque      : 3;
}

struct AccelerationStructureTriangleGeometryDesc {
    uint                           max_vertex_count;
    uint                           max_primitive_count;
    AccelerationStructureIndexType index_type;
    bool                           has_transform;
}

struct AccelerationStructureAabbGeometryDesc {
    uint max_primitive_count;
}

struct AccelerationStructureGeometryDesc {
    AccelerationStructureGeometryKind         kind;
    AccelerationStructureGeometryFlags        flags;
    AccelerationStructureTriangleGeometryDesc triangles;
    AccelerationStructureAabbGeometryDesc     aabbs;
}

struct AccelerationStructureDesc {
    AccelerationStructureKind          kind;
    AccelerationStructureGeometryDesc[] geometries;
    uint                                max_instance_count;
    AccelerationStructureBuildFlags     flags;
    ZString                             debug_name;
}

struct AccelerationStructureRequirements {
    usz storage_size;
    usz storage_alignment;
    usz build_scratch_size;
    usz update_scratch_size;
    usz scratch_alignment;
}

struct AccelerationStructureInstanceDesc {
    Vec4f                              transform_row_0;
    Vec4f                              transform_row_1;
    Vec4f                              transform_row_2;
    AccelerationStructureHandle        bottom_level;
    uint                               custom_index;
    uint                               mask;
    AccelerationStructureInstanceFlags flags;
}

// A shader-visible 64-bit GPU address. Distinct from a plain ulong so it can't
// be confused with sizes, offsets, or handles.
typedef GpuAddress = ulong;

enum MemoryClass : int {
    CPU_WRITE,
    GPU_PRIVATE,
    CPU_READ,
    TEXTURE,
}

<* Non-owning identity and range into generic GPU data. *>
struct GpuSpan {
    ulong owner;
    uint  index;
    uint  generation;
    usz   offset;
    usz   size;
}

struct DedicatedAccelerationStructure {
    AccelerationStructureHandle acceleration_structure;
    GpuAllocation               allocation;
}

<* Consistent non-owning CPU and GPU views of one mapped span.
   `bytes.len` must equal `span.size`. All fields inherit the lifetime of the
   span's owning allocation; copying this value retains nothing. *>
struct MappedGpuSpan {
    GpuSpan    span;
    char[]     bytes;
    GpuAddress address;
}

<* `size` must be nonzero; alignment zero selects 16 bytes. *>
struct AllocationDesc {
    usz         size;
    usz         alignment;
    MemoryClass memory_class;
    QueueRoles  access;
    TextureRequirements[] texture_requirements;
    ZString     debug_name;
}

<* Immutable allocation properties and actual mapping behavior. *>
struct AllocationInfo {
    usz         size;
    usz         alignment;
    MemoryClass memory_class;
    QueueRoles  access;
    bool        mapped;
    bool        coherent;
    bool        addressable;
}

const usz MAX_MEMORY_HEAPS = 16;

// Per-heap memory usage snapshot.
struct MemoryHeapBudget {
    ulong usage;
    ulong budget;
    ulong allocation_bytes;
    ulong block_bytes;
}

// Device memory snapshot. `heaps[0..heap_count]` are valid.
struct MemoryStats {
    MemoryHeapBudget[MAX_MEMORY_HEAPS] heaps;
    uint  heap_count;
    ulong texture_count;
    ulong live_allocation_count;
}

<* Opaque device-owned compatibility value for texture placement. *>
typedef TextureCompatibility = uint128;

const uint DEFAULT_TEXTURE_CAPACITY = 1024;

<* Texel format for textures and swapchain images. BC formats are
   block-compressed: 4x4 texel blocks of 8 bytes (BC1, BC4) or 16 bytes
   (BC3, BC5, BC6H, BC7). They are sampled-only, single-sampled 2D formats
   whose copies move precompressed blocks unchanged. *>
enum Format : int {
    UNDEFINED,
    R8_UNORM,
    R8_UINT,
    RG8_UNORM,
    RGBA8_UNORM,
    RGBA8_SRGB,
    BGRA8_UNORM,
    BGRA8_SRGB,
    R16_UINT,
    R16_FLOAT,
    RG16_FLOAT,
    RGBA16_FLOAT,
    R32_UINT,
    R32_FLOAT,
    RG32_FLOAT,
    RGBA32_FLOAT,
    D32_FLOAT,
    BC1_RGBA_UNORM,
    BC1_RGBA_SRGB,
    BC3_UNORM,
    BC3_SRGB,
    BC4_UNORM,
    BC5_UNORM,
    BC6H_UFLOAT,
    BC7_UNORM,
    BC7_SRGB,
}

<* Rasterization samples per texel. The zero value is single-sampled. *>
enum SampleCount : int {
    ONE,
    TWO,
    FOUR,
    EIGHT,
    SIXTEEN,
    THIRTY_TWO,
    SIXTY_FOUR,
}

<* Sampler texel filtering. *>
enum Filter : int {
    NEAREST,
    LINEAR,
}

<* How samplers treat coordinates outside [0, 1]. *>
enum AddressMode : int {
    REPEAT,
    MIRRORED_REPEAT,
    CLAMP_TO_EDGE,
    CLAMP_TO_BORDER,
}

// Texture usage flags. Bitstruct of bools, composed by field-set.
bitstruct TextureUsage : uint {
    // Sampled through the descriptor heap.
    bool sampled      : 0;
    // Storage-image access from shaders.
    bool storage      : 1;
    // Render-pass color target.
    bool color_attach : 2;
    // Render-pass depth target.
    bool depth_attach : 3;
    // Source of copies/readbacks.
    bool transfer_src : 4;
    // Destination of uploads/copies.
    bool transfer_dst : 5;
}

<* Individually creatable optimal-tiling format features. Feature
   combinations must be checked with supports_texture_desc. *>
bitstruct TextureFormatFeatures : uint {
    bool sampled       : 0;
    bool storage       : 1;
    bool color_attach  : 2;
    bool depth_attach  : 3;
    bool transfer_src  : 4;
    bool transfer_dst  : 5;
    bool linear_filter : 6;
}

<* Texture sample counts implemented end-to-end by the backend. *>
bitstruct TextureSampleCountSupport : uint {
    bool one        : 0;
    bool two        : 1;
    bool four       : 2;
    bool eight      : 3;
    bool sixteen    : 4;
    bool thirty_two : 5;
    bool sixty_four : 6;
}

<* Library-creatable support for one format. *>
struct TextureFormatSupport {
    TextureFormatFeatures     features;
    TextureSampleCountSupport sample_counts;
}

<* Storage requirements for one texture descriptor. *>
struct TextureRequirements {
    usz                  size;
    usz                  alignment;
    TextureCompatibility compatibility;
    bool                 dedicated_only;
}

const uint MAX_SPARSE_TEXTURE_ASPECTS = 2;

enum SparseTextureAspect : int {
    COLOR,
    METADATA,
}

<* Sparse tile and mip-tail layout for one backend-neutral image aspect.
   A single mip tail always reports stride zero. METADATA tile extent may be
   zero. *>
struct SparseTextureAspectRequirements {
    SparseTextureAspect aspect;
    Vec3u               tile_extent;
    uint                mip_tail_first_lod;
    usz                 mip_tail_size;
    usz                 mip_tail_offset;
    usz                 mip_tail_stride;
    bool                single_mip_tail;
    bool                aligned_mip_size;
    bool                nonstandard_block_size;
}

<* Immutable requirements for one live sparse texture. `virtual_size` is not
   committed storage. `page_allocation` describes compatible caller-owned
   TEXTURE memory, and only `aspects[:aspect_count]` are meaningful. *>
struct SparseTextureRequirements {
    usz                                                       virtual_size;
    TextureRequirements                                       page_allocation;
    uint                                                      aspect_count;
    SparseTextureAspectRequirements[MAX_SPARSE_TEXTURE_ASPECTS] aspects;
}

<* One color image-tile bind. The exact invalid allocation unbinds the region
   when allocation_offset is zero. *>
struct SparseTextureTileBind {
    SparseTextureAspect aspect;
    uint                mip_level;
    Vec3u               offset;
    Vec3u               extent;
    GpuAllocation       allocation;
    usz                 allocation_offset;
}

<* One color or metadata mip-tail bind. The exact invalid allocation unbinds
   the range when allocation_offset is zero. *>
struct SparseTextureOpaqueBind {
    SparseTextureAspect aspect;
    usz                 resource_offset;
    usz                 size;
    GpuAllocation       allocation;
    usz                 allocation_offset;
}

<* One transactional sparse mutation and its stage-free completion waits. *>
struct SparseTextureBindDesc {
    TextureHandle             texture;
    SparseTextureTileBind[]   tiles;
    SparseTextureOpaqueBind[] opaque;
    CompletionPoint[]         waits;
}

<* Independently owned texture and allocation returned by dedicated creation. *>
struct DedicatedTexture {
    TextureHandle texture;
    GpuAllocation allocation;
}

<* Creation parameters for create_texture. Zero depth selects 2D; positive
   depth selects 3D. `access` must be a non-empty subset of the device's
   selected queue roles. *>
struct TextureDesc {
    uint             width;
    uint             height;
    // 0 creates a 2D texture; positive values create a 3D texture.
    uint             depth;
    // 0 means 1.
    uint             mip_levels;
    // 0 means 1.
    uint             array_layers;
    Format           format;
    TextureUsage     usage;
    QueueRoles       access;
    SampleCount      sample_count;
    ZString          debug_name;
}

<* Subresource view of a texture; a zero-initialized desc is the full default view. *>
struct TextureViewDesc {
    uint   base_mip;
    // 0 means all mips from base_mip.
    uint   mip_count;
    uint   base_layer;
    // 0 means all layers from base_layer.
    uint   layer_count;
}

<* Semantic parameters for intern_sampler. *>
struct SamplerDesc {
    Filter      min_filter;
    Filter      mag_filter;
    Filter      mip_filter;
    AddressMode address_u;
    AddressMode address_v;
    AddressMode address_w;
    // LOD values must be finite; min_lod must not exceed max_lod. The absolute
    // mip_lod_bias value must not exceed caps.max_sampler_lod_bias.
    float       mip_lod_bias;
    float       min_lod;
    float       max_lod;
    // Requires caps.max_sampler_anisotropy > 0.
    bool        anisotropy_enable;
    // Ignored when anisotropy_enable is false. When enabled, must be finite
    // and >= 1; above caps.max_sampler_anisotropy faults INVALID_ARGUMENT.
    float       max_anisotropy;
    // With `compare`, enables depth-compare (shadow) sampling. The compare
    // value is ignored when compare_enable is false.
    bool        compare_enable;
    CompareOp   compare;
    ZString     debug_name;
}

const uint DEFAULT_TEXTURE_HEAP_CAPACITY = 4096;

const uint DEFAULT_SAMPLER_HEAP_CAPACITY = 256;

const uint MAX_SHADER_HEAP_CAPACITY = 65_536;

<* One create_texture_views input. A zero-initialized view description selects
   the default view, matching a null description passed to create_texture_view. *>
struct TextureViewCreateDesc {
    TextureHandle   texture;
    TextureViewDesc view;
}

// ---- Shaders and pipelines ----

// Default pipeline slot capacity when RuntimeDesc.pipeline_capacity is zero.
const uint MAX_PIPELINES                  = 256;

const uint MAX_COLOR_ATTACHMENTS          = 8;

<* How draws assemble vertices into primitives. *>
enum PrimitiveTopology : int {
    TRIANGLES,
    LINES,
    POINTS,
}

<* Comparison function for depth testing. *>
enum CompareOp : int {
    NEVER,
    LESS,
    EQUAL,
    LESS_EQUAL,
    GREATER,
    NOT_EQUAL,
    GREATER_EQUAL,
    ALWAYS,
}

<* Triangle facing discarded by the rasterizer. *>
enum CullMode : int {
    NONE,
    FRONT,
    BACK,
}

<* Winding order that counts as front-facing. *>
enum FrontFace : int {
    COUNTER_CLOCKWISE,
    CLOCKWISE,
}

<* Triangle rasterization: filled or wireframe. LINE requires
   DeviceCaps.line_polygon_mode. *>
enum PolygonMode : int {
    FILL,
    LINE,
}

<* Multiplier for the source or destination term of the blend equation. *>
enum BlendFactor : int {
    ZERO,
    ONE,
    SRC_COLOR,
    ONE_MINUS_SRC_COLOR,
    SRC_ALPHA,
    ONE_MINUS_SRC_ALPHA,
    DST_ALPHA,
    ONE_MINUS_DST_ALPHA,
}

<* Operator combining the weighted source and destination blend terms. *>
enum BlendOp : int {
    ADD,
    SUBTRACT,
    REVERSE_SUBTRACT,
    MIN,
    MAX,
}

<* Native ray-tracing hit-group topology. Procedural groups require an
   intersection shader; triangle groups prohibit one. *>
enum RayTracingHitGroupKind : int {
    TRIANGLES,
    PROCEDURAL,
}

<* Shader role selected by a per-group ray-tracing stack-size query. *>
enum RayTracingGroupShader : int {
    GENERAL,
    CLOSEST_HIT,
    ANY_HIT,
    INTERSECTION,
}

<* Color channels written by one graphics target; zero disables all writes. *>
bitstruct ColorWriteMask : uint {
    bool red   : 0;
    bool green : 1;
    bool blue  : 2;
    bool alpha : 3;
}

const ColorWriteMask COLOR_WRITE_ALL = {
    .red   = true,
    .green = true,
    .blue  = true,
    .alpha = true,
};

<* Borrowed SPIR-V input for one pipeline stage. A null entry point selects
   `main`; the enclosing field determines the role. Storage is call-scoped. *>
struct ShaderDesc {
    char[]  spirv;
    ZString entry_point;
    ZString debug_name;
}

<* Depth test/write state; the zero value means depth off. *>
struct DepthState {
    bool      test_enable;
    bool      write_enable;
    CompareOp compare;
}

<* Blend equation for one color target; disabled is the zero value. *>
struct BlendState {
    bool        enable;
    BlendFactor src_color;
    BlendFactor dst_color;
    BlendOp     color_op;
    BlendFactor src_alpha;
    BlendFactor dst_alpha;
    BlendOp     alpha_op;
}

<* Command-time blend equation and write mask for one color target. *>
struct ColorTargetState {
    BlendState     blend;
    ColorWriteMask write_mask;
}

<* Borrowed complete color state for a selected graphics pipeline. *>
struct ColorState {
    ColorTargetState[] targets;
}

<* Pass-bounded raster state; zero means triangles, no culling,
   counter-clockwise front faces, and disabled depth bias. *>
struct DynamicRasterState {
    PrimitiveTopology topology;
    CullMode          cull_mode;
    FrontFace         front_face;
    bool              depth_bias_enable;
    float             depth_bias_constant;
    float             depth_bias_slope;
    float             depth_bias_clamp;
}

<* Inputs to create_compute_pipeline; the layout uses the fixed RootPush ABI. *>
struct ComputePipelineDesc {
    ShaderDesc shader;
    ZString    debug_name;
}

<* Inputs to create_graphics_pipeline, targeting dynamic rendering. The layout
   is fixed: the global heap set plus a 16-byte vertex/fragment root push range. *>
struct GraphicsPipelineDesc {
    ShaderDesc   vertex_shader;
    ShaderDesc   fragment_shader;
    Format[]     color_formats;
    Format       depth_format;
    SampleCount  sample_count;
    PolygonMode  polygon_mode;
    ZString      debug_name;
}

<* One borrowed hit-group declaration. Shader inputs and pointed descriptors
   are call-scoped; group kind determines required and prohibited roles. *>
struct RayTracingHitGroupDesc {
    RayTracingHitGroupKind kind;
    ShaderDesc*            closest_hit_shader;
    ShaderDesc*            any_hit_shader;
    ShaderDesc*            intersection_shader;
}

<* Borrowed ordered shader categories for one ray-tracing pipeline. Creation
   copies all inputs; dynamic stack sizing is an explicit opt-in. *>
struct RayTracingPipelineDesc {
    ShaderDesc[]             ray_generation_shaders;
    ShaderDesc[]             miss_shaders;
    RayTracingHitGroupDesc[] hit_groups;
    ShaderDesc[]             callable_shaders;
    uint                     max_recursion_depth;
    bool                     dynamic_stack_size;
    ZString                  debug_name;
}

<* Half-open category range in the pipeline's deterministic group order. *>
struct RayTracingShaderGroupRange {
    uint first_group;
    uint group_count;
}

<* Deterministic ray-generation, miss, hit, and callable group ranges. *>
struct RayTracingPipelineInfo {
    RayTracingShaderGroupRange ray_generation;
    RayTracingShaderGroupRange miss;
    RayTracingShaderGroupRange hit;
    RayTracingShaderGroupRange callable;
    uint                       total_group_count;
    uint                       max_recursion_depth;
    bool                       dynamic_stack_size;
}

<* Caller-owned SBT records in GPU-addressable memory. Empty optional regions
   use the canonical zero value; nonempty spans retain caller ownership. *>
struct RayTracingShaderBindingTableRegion {
    GpuSpan span;
    usz     stride;
}

<* Caller-packed SBT regions for one direct trace. The ray-generation region is
   required and contains exactly one record. *>
struct RayTracingShaderBindingTable {
    RayTracingShaderBindingTableRegion ray_generation;
    RayTracingShaderBindingTableRegion miss;
    RayTracingShaderBindingTableRegion hit;
    RayTracingShaderBindingTableRegion callable;
}

// ---- Commands and rendering ----

struct AccelerationStructureTriangleBuildDesc {
    GpuSpan vertices;
    usz     vertex_stride;
    uint    vertex_count;
    GpuSpan indices;
    uint    primitive_count;
    GpuSpan transform;
}

struct AccelerationStructureAabbBuildDesc {
    GpuSpan aabbs;
    usz     stride;
    uint    primitive_count;
}

struct AccelerationStructureGeometryBuildDesc {
    AccelerationStructureGeometryKind      kind;
    AccelerationStructureTriangleBuildDesc triangles;
    AccelerationStructureAabbBuildDesc     aabbs;
}

<* Dynamic inputs for one BLAS or TLAS construction. Counts are actual for
   direct commands and CPU maxima for indirect commands; triangle
   `vertex_count` always supplies the exact `maxVertex + 1` bound. *>
struct AccelerationStructureBuildDesc {
    AccelerationStructureHandle              destination;
    AccelerationStructureGeometryBuildDesc[] geometries;
    GpuSpan                                  instances;
    uint                                     instance_count;
    GpuSpan                                  scratch;
}

<* Element width of an index buffer; indexed draws default to U32. *>
enum IndexType : int {
    U32,
    U16,
}

const uint DEFAULT_COMMAND_ALLOCATOR_CAPACITY = 8;

const uint DEFAULT_COMMAND_REFERENCES_PER_LIST = 64;

const uint MAX_COMMAND_ALLOCATOR_CAPACITY = 4096;

const uint MAX_COMMAND_REFERENCES_PER_LIST = 4096;

<* Generated-work record kind a reservation serves. *>
enum GeneratedWorkKind : int {
    DRAW,
    DRAW_INDEXED,
    DISPATCH,
}

<* Unsigned 3-vector; dispatches take their workgroup counts as one. *>
struct Vec3u {
    uint x;
    uint y;
    uint z;
}

<* One render-pass dynamic viewport. All fields must be finite. Width is
   positive; height is nonzero and may be negative for a Y flip. Coordinates,
   dimensions, and endpoints must fit the selected device's viewport limits,
   but the viewport may extend outside the render area. Both depth endpoints
   are independently in [0, 1], in either order. Set max_depth to 1.0f for the
   conventional full depth range. *>
struct Viewport {
    float x;
    float y;
    float width;
    float height;
    float min_depth;
    float max_depth;
}

<* One render-pass dynamic scissor. Fields are nonnegative and each offset
   plus extent must fit a signed integer. The rectangle may extend outside the
   render area; Vulkan clips it to the render target. Zero extent is a valid
   empty clip. *>
struct ScissorRect {
    int x;
    int y;
    int width;
    int height;
}

<* Complete command-buffer graphics state for subsequent draws. *>
struct GraphicsState {
    Viewport           viewport;
    ScissorRect        scissor;
    DynamicRasterState raster;
    DepthState         depth;
    ColorState         color;
}

// Shader-writable indirect argument layouts; GLSL definitions are generated
// in include/shaders/generated/shader_abi.glsl.
struct DrawIndirectCommand {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
}
$assert DrawIndirectCommand::size == 16;

<* Shader-writable arguments for indexed indirect draws. *>
struct DrawIndexedIndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
}
$assert DrawIndexedIndirectCommand::size == 20;

<* Shader-writable workgroup counts for cmd_dispatch_indirect. *>
struct DispatchIndirectCommand {
    uint x;
    uint y;
    uint z;
}
$assert DispatchIndirectCommand::size == 12;

<* Shader-writable dimensions for cmd_trace_rays_indirect. *>
struct TraceRaysIndirectCommand {
    uint width;
    uint height;
    uint depth;
}
$assert TraceRaysIndirectCommand::size == 12;

struct TraceRaysIndirectCommand2 {
    GpuAddress ray_generation_record_address;
    ulong      ray_generation_record_size;
    GpuAddress miss_table_address;
    ulong      miss_table_size;
    ulong      miss_table_stride;
    GpuAddress hit_table_address;
    ulong      hit_table_size;
    ulong      hit_table_stride;
    GpuAddress callable_table_address;
    ulong      callable_table_size;
    ulong      callable_table_stride;
    uint       width;
    uint       height;
    uint       depth;
    uint       _pad0;
}
$assert TraceRaysIndirectCommand2::size == 104;

<* Shader-writable range for one indirect acceleration-structure geometry.
   `primitive_count` is the actual GPU-selected count, including zero, and must
   fit the CPU maximum in AccelerationStructureBuildDesc. `primitive_offset` is
   a byte offset aligned to the index element for indexed triangles, the
   smallest vertex-format component size for non-indexed triangles, 8 bytes for
   AABBs, or 16 bytes for TLAS instances. `transform_offset` is 16-byte aligned.
   `first_vertex` offsets triangle vertex addressing; every resulting vertex
   index must remain below the descriptor's exact `vertex_count` bound. Pack
   one record per BLAS geometry, or one for a TLAS, at 16-byte stride. *>
struct AccelerationStructureIndirectBuildRange {
    uint primitive_count;
    uint primitive_offset;
    uint first_vertex;
    uint transform_offset;
}
$assert AccelerationStructureIndirectBuildRange::size == 16;

<* A fixed-capacity command recording owner bound to one exact queue. One
   allocator is confined to one recording thread while recordings are live. *>
struct CommandAllocator {
    Device                 device;
    Queue                  queue;
    CommandAllocatorHandle handle;
}

<* Zero capacities select the documented defaults except acceleration-structure
   geometry capacity, where zero disables build recording. Generated-work
   storage is owned by the backend and sized by explicit reservations. *>
struct CommandAllocatorDesc {
    uint    command_buffer_capacity;
    uint    max_resource_references_per_list;
    ZString debug_name;
    uint    max_acceleration_structure_geometries_per_build;
}

<* Cold reservation for one generated-work pipeline and command kind on one
   allocator. Command count bounds the records one generated call may request.
   Every generated call still in flight holds one unit of the reservation, so
   size concurrent lists as command units times generated calls per unit, not
   as a count of command units. The backend derives and owns the private
   storage both imply. *>
struct GeneratedWorkReservationDesc {
    PipelineHandle    pipeline;
    GeneratedWorkKind kind;
    uint              max_commands_per_list;
    uint              concurrent_lists;
}

<* Byte-range copy for cmd_copy_buffer; src and dst must have equal size and
   must not overlap. *>
struct BufferCopyDesc {
    GpuSpan src;
    GpuSpan dst;
}

<* Buffer-to-texture copy region. Zero width/height selects the remaining mip
   extent from x/y; zero 3D depth selects the remainder from z. Zero layer
   count is one, and zero row length means tightly packed rows.

   Coordinates and extents are texels. For block-compressed formats x, y, and
   row_length_texels must be multiples of the block edge, and width/height
   must be multiples of the block edge or reach the mip edge. The buffer holds
   whole blocks: a row is ceil(row_texels / block) blocks, a slice is
   ceil(height / block) rows, and a 1x1 mip still occupies one block. The
   span offset must be a multiple of the block byte size and of four. *>
struct BufferTextureCopyDesc {
    GpuSpan       src;
    uint          row_length_texels;
    TextureHandle texture;
    uint          mip;
    uint          base_layer;
    uint          layer_count;
    uint          x;
    uint          y;
    uint          z;
    uint          width;
    uint          height;
    uint          depth;
}

<* Texture-to-buffer readback region with the same dimension-specific
   zero-value defaults as BufferTextureCopyDesc. *>
struct TextureBufferCopyDesc {
    TextureHandle texture;
    GpuSpan       dst;
    uint          row_length_texels;
    uint          mip;
    uint          base_layer;
    uint          layer_count;
    uint          x;
    uint          y;
    uint          z;
    uint          width;
    uint          height;
    uint          depth;
}

const uint DEFAULT_ATTACHMENT_VIEW_CAPACITY = 4096;

<* What happens to an attachment's contents when a render pass begins. *>
enum LoadOp : int {
    LOAD,
    CLEAR,
    DONT_CARE,
}

<* Whether an attachment's contents persist after the render pass ends. *>
enum StoreOp : int {
    STORE,
    DONT_CARE,
}

<* Color clear value. Use rgba for normalized/floating-point formats and
   uint_rgba for unsigned-integer formats. *>
union ClearColor {
    float[4] rgba;
    uint[4]  uint_rgba;
}
$assert ClearColor::size == 16;

<* Depth clear value; depth in [0, 1]. *>
struct ClearDepth {
    float depth;
}

<* One texture subresource prepared for render-pass attachment use.
   Ownership: release with destroy_attachment_view after GPU use completes. *>
struct AttachmentViewDesc {
    TextureHandle texture;
    uint          mip_level;
    uint          array_layer;
}

<* One color attachment and its optional single-sample resolve target. *>
struct ColorTargetDesc {
    AttachmentViewHandle view;
    AttachmentViewHandle resolve_view;
    LoadOp               load_op;
    StoreOp              store_op;
    ClearColor           clear;
}

<* One depth attachment. `clear` applies only with LoadOp.CLEAR. *>
struct DepthTargetDesc {
    AttachmentViewHandle view;
    LoadOp               load_op;
    StoreOp              store_op;
    ClearDepth           clear;
}

<* A dynamic render pass. Every selected attachment must cover the render area. *>
struct RenderPassDesc {
    ColorTargetDesc[] colors;
    DepthTargetDesc*  depth;
    uint              width;
    uint              height;
}

// ---- Synchronization and submission ----

struct TimestampPoolDesc {
    uint    capacity;
    ZString debug_name;
}

const ulong TIMEOUT_INFINITE = ulong::max;

const CompletionPoint COMPLETION_POINT_INVALID = {};

<* Execution scopes. `all` and `present` are exclusive. *>
bitstruct StageMask : uint {
    bool all             : 0;
    bool host            : 1;
    bool transfer        : 2;
    bool compute         : 3;
    bool vertex_shader   : 4;
    bool fragment_shader : 5;
    bool color_output    : 6;
    bool depth_output    : 7;
    bool present         : 8;
    bool indirect        : 9;
    bool acceleration_structure_build : 10;
    bool ray_tracing     : 11;
}

<* Texture layout for explicit transitions. *>
enum TextureLayout : int {
    UNDEFINED,
    TRANSFER_SOURCE,
    TRANSFER_DESTINATION,
    SAMPLED,
    STORAGE,
    COLOR_ATTACHMENT,
    DEPTH_ATTACHMENT,
    PRESENT,
}

<* Read/write intent for a texture state. The zero value means no access and is
   valid only for `UNDEFINED` and `PRESENT` states. *>
bitstruct TextureAccess : uint {
    bool read  : 0;
    bool write : 1;
}

<* Queue-owned submission progress. Copy and reuse until its device is destroyed. *>
struct CompletionPoint {
    Device device;
    ulong  payload;
}

<* A published queue completion and its first destination consumers. *>
struct CompletionWait {
    CompletionPoint point;
    StageMask       before;
}

<* Global execution and memory dependency with no resource identity or range. *>
struct Barrier {
    StageMask before;
    StageMask after;
}

<* Layout, execution stages, and access intent for one texture use. The zero
   value is the exact empty `UNDEFINED` source state. *>
struct TextureState {
    TextureLayout layout;
    StageMask     stages;
    TextureAccess access;
}

<* Explicit semantic transition for a texture subresource range. A zero `view`
   selects the full texture. *>
struct TextureBarrier {
    TextureHandle   texture;
    TextureViewDesc view;
    TextureState    before;
    TextureState    after;
}

<* Work submitted to an explicit queue. Every wait names its first destination
   stages. Non-zero readiness requires a graphics-capable queue and an explicit
   supported destination stage, and is consumed only by successful submission. *>
struct SubmitDesc {
    ExecutableCommandList[] command_lists;
    CompletionWait[]        completion_waits;
    SwapchainReadiness      readiness;
    StageMask               readiness_before;
}

// ---- Presentation and diagnostics ----

alias DebugMessageCallback = fn void (DebugMessage*, void*);

enum DebugMessageSeverity : int {
    VERBOSE,
    INFO,
    WARNING,
    ERROR,
}

enum DebugResourceKind : int {
    NONE,
    DEVICE,
    GPU_SPAN,
    TEXTURE,
    PIPELINE,
    SWAPCHAIN,
    SHADER,
    COMMAND_ALLOCATOR,
    COMMAND_LIST,
    TEXTURE_DESCRIPTOR,
    SAMPLER,
    ALLOCATION,
    ATTACHMENT_VIEW,
    TIMESTAMP_POOL,
    ACCELERATION_STRUCTURE,
    ACCELERATION_STRUCTURE_VIEW,
}

bitstruct DebugMessageCategory : uint {
    bool public_contract   : 0;
    bool backend           : 1;
    bool validation        : 2;
    bool performance       : 3;
    bool resource_lifetime : 4;
    bool general           : 5;
}

<* Public resource identity when a diagnostic originates from a tracked slot.
   Strings remain valid only for the duration of the callback. *>
struct DebugResourceRef {
    DebugResourceKind kind;
    bool              has_public_identity;
    uint              index;
    uint              generation;
    ZString           debug_name;
}

<* Structured diagnostic delivered synchronously to the configured callback.
   All strings remain valid only for the duration of the callback. *>
struct DebugMessage {
    DebugMessageSeverity severity;
    DebugMessageCategory category;
    ZString              operation;
    bool                 has_fault;
    fault                public_fault;
    DebugResourceRef     resource;
    ZString              rejected_field;
    ZString              invariant;
    ZString              backend_text;
    ZString              validation_id_name;
    int                  validation_id_number;
}

const ulong RESOURCE_OWNER_KIND_COUNT = 13;

const ulong MAX_DEVICE_RESOURCE_OWNER =
    ulong::max / RESOURCE_OWNER_KIND_COUNT;

const uint MAX_SWAPCHAINS = 8;

const SwapchainReadiness SWAPCHAIN_READINESS_INVALID = {};

<* Pacing of presentation; unsupported requested modes fall back to FIFO. *>
enum PresentMode : int {
    // Vsync; always available.
    FIFO,
    // No vsync; may tear.
    IMMEDIATE,
    // Low-latency vsync; may drop frames.
    MAILBOX,
}

<* Present modes a swapchain's surface supports, from get_present_mode_support. *>
bitstruct PresentModeSupport : uint {
    bool fifo;
    bool immediate;
    bool mailbox;
}

<* Creation parameters for create_swapchain. *>
struct SwapchainDesc {
    uint        width;
    uint        height;
    Format      preferred_format;
    PresentMode present_mode;
    // 0 means backend default.
    uint        image_count;
    // Selects sRGB over UNORM encoding for the swapchain format.
    bool        srgb;
    ZString     debug_name;
}

<* Actual swapchain configuration selected by the backend. Dormant snapshots
   use UNDEFINED format, zero extent/count, and FIFO as an ignored mode
   sentinel. *>
struct SwapchainInfo {
    Format      format;
    uint        width;
    uint        height;
    uint        image_count;
    PresentMode present_mode;
    bool        dormant;
}

<* One-shot acquisition readiness. Submission accepts it exactly once. *>
struct SwapchainReadiness {
    Device device;
    ulong  payload;
}
$assert(SwapchainReadiness::size <= ulong::size * 2);

<* Borrowed swapchain texture, its color attachment view, and its one-shot
   acquisition identity. Resize invalidates both handles; an enqueued
   presentation consumes the value. *>
struct AcquiredImage {
    TextureHandle        texture;
    AttachmentViewHandle attachment_view;
    SwapchainReadiness   readiness;
    uint                 index;
    bool                 suboptimal;
    TextureState         prior_state;
}
