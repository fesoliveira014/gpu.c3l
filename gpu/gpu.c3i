module gpu;

// Public interface for consumers of gpu.c3l.

// Shared-ABI vector aliases: plain SIMD vectors (element-aligned in structs;
// std430 vector alignment comes from explicit padding validated by the ABI
// generator, not from these types).
alias Vec2f = float[<2>];
// Same shared-ABI rules as Vec2f.
alias Vec4f = float[<4>];
// Same shared-ABI rules as Vec2f.
alias Vec4u = uint[<4>];
$assert Vec2f::size == 8;
$assert Vec4f::size == 16;
$assert Vec4u::size == 16;

// Device handles are compact registry tokens. Device-owned resources also
// carry an exact owner identity so coincident local slots cannot alias.

bitstruct Device : ulong {
    uint index      : 0..31;
    uint generation : 32..55;
    uint reserved   : 56..63;
}

// Fixed-width shader-visible heap values. Value zero is the invalid sentinel;
// live values encode the zero-based backend slot plus one and carry no CPU
// ownership or generation metadata.
bitstruct TextureIndex : uint {
    uint value : 0..31;
}

bitstruct SamplerIndex : uint {
    uint value : 0..31;
}

<* Owning token for device-scoped generic GPU data. *>
struct GpuAllocation {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert GpuAllocation::size <= ulong::size * 2;

struct TextureHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert TextureHandle::size <= ulong::size * 2;

struct AttachmentViewHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert AttachmentViewHandle::size <= ulong::size * 2;

<* Owning CPU token for one published texture view. `index` is the raw value
   stored in shader data; ownership and generation stay CPU-only. *>
struct TextureView {
    ulong        owner;
    TextureIndex index;
    uint         generation;
}
$assert TextureView::size <= ulong::size * 2;

struct PipelineHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert PipelineHandle::size <= ulong::size * 2;

struct SwapchainHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert SwapchainHandle::size <= ulong::size * 2;

struct CommandListHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert CommandListHandle::size <= ulong::size * 2;

<* Generation-checked identity for a command allocator owned by one device. *>
struct CommandAllocatorHandle {
    ulong owner;
    uint  index;
    uint  generation;
}
$assert CommandAllocatorHandle::size <= ulong::size * 2;

const Device                 DEVICE_INVALID                   = {};
const GpuAllocation          GPU_ALLOCATION_INVALID           = {};
const TextureHandle          TEXTURE_HANDLE_INVALID           = {};
const AttachmentViewHandle   ATTACHMENT_VIEW_HANDLE_INVALID   = {};
const TextureView            TEXTURE_VIEW_INVALID             = {};
const PipelineHandle         PIPELINE_HANDLE_INVALID          = {};
const SwapchainHandle        SWAPCHAIN_HANDLE_INVALID         = {};
const CommandListHandle      COMMAND_LIST_HANDLE_INVALID      = {};
const CommandAllocatorHandle COMMAND_ALLOCATOR_HANDLE_INVALID = {};

const TextureIndex TEXTURE_INDEX_INVALID = {};
const SamplerIndex SAMPLER_INDEX_INVALID = {};

// Public fault set. `faultdef` declares a flat list of globally-unique values
// in module gpu, referenced as `gpu::<NAME>` and raised with the `~` suffix.
// Each entry notes when it fires; docs/api.md carries the full fault table.
faultdef
    // No backend for the requested BackendKind, no Vulkan 1.3 driver, or
    // instance/device creation failed outright.
    UNSUPPORTED_BACKEND,
    // A valid requested capability is unavailable: validation layers not
    // installed, presentation unsupported, missing feature, or no adapter
    // can provide an exact semantic capacity.
    UNSUPPORTED_FEATURE,
    // A descriptor or parameter is malformed: zero sizes, out-of-range
    // values, undersized output buffers, mismatched spans.
    INVALID_ARGUMENT,
    // A handle is stale (generation mismatch after destroy) or was never
    // live; also raised for zero, consumed, or stale device tokens.
    INVALID_HANDLE,
    // A stateful token or resource lifecycle is incompatible with the
    // requested operation.
    INVALID_RESOURCE_STATE,
    // Host-side allocation failure reported by the driver.
    OUT_OF_HOST_MEMORY,
    // Device memory exhausted (VMA/driver allocation failure).
    OUT_OF_DEVICE_MEMORY,
    // The driver reported VK_ERROR_DEVICE_LOST. The affected device rejects
    // later operations; peer devices remain usable.
    DEVICE_LOST,
    // A device operation encountered closing state or sustained pin
    // contention. Destruction may also return this fault. Safe to retry.
    DEVICE_BUSY,
    // Destruction found a live owner: a device child, runtime dependent,
    // surface swapchain, or texture descriptor. Release the owner first.
    RESOURCE_IN_USE,
    // A handle table hit its configured resource capacity.
    SLOT_TABLE_FULL,
    // Explicitly reserved recording storage cannot satisfy the requested work.
    GENERATED_SCRATCH_EXHAUSTED,
    // Fixed command allocator bookkeeping cannot represent requested work.
    COMMAND_ALLOCATOR_CAPACITY_EXCEEDED,
    // No free descriptor slot: capacity is too small for live descriptors.
    DESCRIPTOR_HEAP_FULL,
    // The driver rejected pipeline creation (invalid state combination or
    // internal compile failure).
    PIPELINE_CREATE_FAILED,
    // SPIR-V rejected at shader-module creation.
    SHADER_INVALID,
    // The presentation surface disappeared (window destroyed mid-frame).
    SURFACE_LOST,
    // The swapchain no longer matches the surface (resize, occlusion);
    // recreate via resize_swapchain and retry.
    SWAPCHAIN_OUT_OF_DATE,
    // A cmd_* call outside its required recording state (not recording,
    // wrong pass phase, or list already ended).
    COMMAND_RECORDING_ERROR,
    // A bounded host wait elapsed before its target, or image acquisition
    // reported transient unavailability. The operation is safe to retry
    // without changing the resource being waited on.
    WAIT_TIMEOUT,
    // The backend returned an unclassified or internal failure. Inspect
    // native diagnostics; this does not imply that the device was lost.
    BACKEND_ERROR;

struct RootPush {
    GpuAddress root_gpu;
}
$assert RootPush::size == 8;
$assert $reflect(RootPush.root_gpu).offset == 0;

struct GraphicsRootPush {
    GpuAddress vertex_root_gpu;
    GpuAddress fragment_root_gpu;
}
$assert GraphicsRootPush::size == 16;
$assert $reflect(GraphicsRootPush.vertex_root_gpu).offset == 0;
$assert $reflect(GraphicsRootPush.fragment_root_gpu).offset == 8;

$assert DrawIndirectCommand::size == 16;
$assert $reflect(DrawIndirectCommand.vertex_count).offset == 0;
$assert $reflect(DrawIndirectCommand.instance_count).offset == 4;
$assert $reflect(DrawIndirectCommand.first_vertex).offset == 8;
$assert $reflect(DrawIndirectCommand.first_instance).offset == 12;

$assert DrawIndexedIndirectCommand::size == 20;
$assert $reflect(DrawIndexedIndirectCommand.index_count).offset == 0;
$assert $reflect(DrawIndexedIndirectCommand.instance_count).offset == 4;
$assert $reflect(DrawIndexedIndirectCommand.first_index).offset == 8;
$assert $reflect(DrawIndexedIndirectCommand.vertex_offset).offset == 12;
$assert $reflect(DrawIndexedIndirectCommand.first_instance).offset == 16;

$assert DispatchIndirectCommand::size == 12;
$assert $reflect(DispatchIndirectCommand.x).offset == 0;
$assert $reflect(DispatchIndirectCommand.y).offset == 4;
$assert $reflect(DispatchIndirectCommand.z).offset == 8;

struct GeneratedDrawRecord {
    GpuAddress          vertex_root_gpu;
    GpuAddress          fragment_root_gpu;
    DrawIndirectCommand arguments;
}
$assert GeneratedDrawRecord::size == 32;
$assert $reflect(GeneratedDrawRecord.vertex_root_gpu).offset == 0;
$assert $reflect(GeneratedDrawRecord.fragment_root_gpu).offset == 8;
$assert $reflect(GeneratedDrawRecord.arguments).offset == 16;

struct GeneratedDrawIndexedRecord {
    GpuAddress                 vertex_root_gpu;
    GpuAddress                 fragment_root_gpu;
    DrawIndexedIndirectCommand arguments;
    uint                       _pad0;
}
$assert GeneratedDrawIndexedRecord::size == 40;
$assert $reflect(GeneratedDrawIndexedRecord.vertex_root_gpu).offset == 0;
$assert $reflect(GeneratedDrawIndexedRecord.fragment_root_gpu).offset == 8;
$assert $reflect(GeneratedDrawIndexedRecord.arguments).offset == 16;
$assert $reflect(GeneratedDrawIndexedRecord._pad0).offset == 36;

struct GeneratedDispatchRecord {
    GpuAddress              root_gpu;
    DispatchIndirectCommand arguments;
    uint                    _pad0;
}
$assert GeneratedDispatchRecord::size == 24;
$assert $reflect(GeneratedDispatchRecord.root_gpu).offset == 0;
$assert $reflect(GeneratedDispatchRecord.arguments).offset == 8;
$assert $reflect(GeneratedDispatchRecord._pad0).offset == 20;
