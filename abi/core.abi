abi gpu_core;

// Push constant payloads (docs/shader_abi.md section 10). Shaders bind their
// fields directly in a hand-written layout(push_constant) block.
push RootPush {
    GpuAddress root_gpu;
}

push GraphicsRootPush {
    GpuAddress vertex_root_gpu;
    GpuAddress fragment_root_gpu;
}

struct AccelerationStructureInstance {
    vec4       transform_row_0;
    vec4       transform_row_1;
    vec4       transform_row_2;
    uint       custom_index_and_mask;
    uint       record_offset_and_flags;
    GpuAddress acceleration_structure;
}

// Indirect argument layouts, byte-identical to Vulkan's. The C3 declarations
// live in gpu/command.c3 (public API); these entries generate the GLSL twins and
// the drift-detecting offset asserts.
extern struct DrawIndirectCommand {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
}

extern struct DrawIndexedIndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
}

extern struct DispatchIndirectCommand {
    uint x;
    uint y;
    uint z;
}

extern struct TraceRaysIndirectCommand {
    uint width;
    uint height;
    uint depth;
}

extern struct TraceRaysIndirectCommand2 {
    GpuAddress ray_generation_record_address;
    u64        ray_generation_record_size;
    GpuAddress miss_table_address;
    u64        miss_table_size;
    u64        miss_table_stride;
    GpuAddress hit_table_address;
    u64        hit_table_size;
    u64        hit_table_stride;
    GpuAddress callable_table_address;
    u64        callable_table_size;
    u64        callable_table_stride;
    uint       width;
    uint       height;
    uint       depth;
    uint       _pad0;
}

extern struct AccelerationStructureIndirectBuildRange {
    uint primitive_count;
    uint primitive_offset;
    uint first_vertex;
    uint transform_offset;
}

// GPU-writable roots and arguments consumed as one generated work item.
struct GeneratedDrawRecord {
    GpuAddress          vertex_root_gpu;
    GpuAddress          fragment_root_gpu;
    DrawIndirectCommand arguments;
}

struct GeneratedDrawIndexedRecord {
    GpuAddress                 vertex_root_gpu;
    GpuAddress                 fragment_root_gpu;
    DrawIndexedIndirectCommand arguments;
    uint                       _pad0;
}

struct GeneratedDispatchRecord {
    GpuAddress              root_gpu;
    DispatchIndirectCommand arguments;
    uint                    _pad0;
}
