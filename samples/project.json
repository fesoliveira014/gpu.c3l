{
  "langrev": "1",
  // Stub backend imports vk/vma without using every symbol yet.
  "warnings": [ "no-unused" ],
  // libs/ holds gpu.c3l -> ../.. plus symlinks to the vendored vk.c3l / vma.c3l,
  // mirroring test/libs so a single search path resolves all three by <name>.c3l.
  "dependency-search-paths": [ "libs" ],
  "dependencies": [ "gpu", "vk", "vma" ],
  "output": "build",
  "targets": {
    // Headless: no SDL. Proves the root-pointer compute ABI end to end.
    "root_pointer_compute": {
      "type": "executable",
      "target": "linux-x64",
      "sources": [ "root_pointer_compute/main.c3" ]
    }
  }
}
