{
  "langrev": "1",
  // Stub backend imports vk/vma without using every symbol yet.
  "warnings": [ "no-unused" ],
  // libs/ holds gpu.c3l -> ../.. plus symlinks to the vendored vk.c3l / vma.c3l,
  // mirroring test/libs so a single search path resolves all three by <name>.c3l.
  "dependency-search-paths": [ "libs" ],
  "dependencies": [ "gpu", "vk", "vma", "spvreflect", "sdl3" ],
  "output": "build",
  "targets": {
    // Windowed: SDL3 window + swapchain, presents the textured triangle.
    // Run with --frames N for an auto-exit smoke, --no-vsync for MAILBOX.
    "hello_triangle_sdl": {
      "type": "executable",
      "target": "linux-x64",
      "sources": [ "hello_triangle_sdl/main.c3", "shared/sample_window_sdl.c3" ]
    },
    // Headless: no SDL. Proves the root-pointer compute ABI end to end.
    "root_pointer_compute": {
      "type": "executable",
      "target": "linux-x64",
      "sources": [ "root_pointer_compute/main.c3" ]
    },
    // Headless rasterization: textured triangle to an offscreen target,
    // dumped as PPM. Proves graphics pipelines + heap from the fragment stage.
    "offscreen_triangle": {
      "type": "executable",
      "target": "linux-x64",
      "sources": [ "offscreen_triangle/main.c3" ]
    },
    // Headless: writes a pattern into a storage image by TextureIndex, then
    // samples it back by the same index. Proves the bindless descriptor heap.
    "bindless_texture_compute": {
      "type": "executable",
      "target": "linux-x64",
      "sources": [ "bindless_texture_compute/main.c3" ]
    }
  }
}
